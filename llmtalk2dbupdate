# --- Cell 3g: High-Performance Synapse Dedicated Pool Write ---
def write_monthly(AOD_C):
    """Write balance_flow14 to Synapse Dedicated Pool using staging."""
    final_df = spark.sql("SELECT * FROM balance_flow14")
    
    # Count ONCE (materializes data)
    row_count = final_df.count()
    
    # For Synapse, we want fewer, larger partitions to feed the COPY command
    df_write = final_df.repartition(8)
    
    # Uppercase columns
    for col_name in df_write.columns:
        df_write = df_write.withColumnRenamed(col_name, col_name.upper())
        
    access_token = mssparkutils.credentials.getToken("DW")
    
    # CRITICAL: Define a staging folder in your primary ADLS Gen2 storage account
    # Synapse uses this folder to bulk-load the data via PolyBase/COPY
    staging_folder = "abfss://<container>@<storage_account>.dfs.core.windows.net/temporary_synapse_staging/"
    
    (
        df_write.write
        # Use the specialized Synapse connector instead of generic "jdbc"
        .format("com.microsoft.sqlserver.jdbc.spark") 
        .option("url", jdbc_url_write)
        .option("dbtable", "dgsa_gold.balance_flow_monthly")
        .option("accessToken", access_token)
        # Enforces the use of PolyBase/COPY architecture
        .option("stagingStorageFolder", staging_folder)
        .mode("append")
        .save()
    )
    
    return row_count
