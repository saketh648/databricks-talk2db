    {"pool": "marketing_analytics_dev_dedicated"},
    {"pool": "digital_dev_dedicated"},
    {"pool": "locations_analytics_prod_dedicated"},
    {"pool": "wcib_prod_dedicated"}
]

# --- SCHEMA ---
schema_template = StructType([
    StructField("ReqId",            StringType(),    True),
    StructField("UserIdentity",     StringType(),    True),
    StructField("SubmitTime",       TimestampType(), True),
    StructField("DurationSec",      LongType(),      True),
    StructField("QueryText",        StringType(),    True),
    StructField("Status",           StringType(),    True),
    StructField("PoolType",         StringType(),    True),
    StructField("PoolName",         StringType(),    True),
    StructField("DataProcessedGB",  DoubleType(),    True),
    StructField("EstimatedCostUSD", DoubleType(),    True)
])

# ============================================================
# PHASE A: DEDICATED POOLS — JDBC DMV PULL
# ============================================================
dedicated_dmv_query = f"""
(
    SELECT
        r.request_id                                AS ReqId,
        s.login_name                                AS UserIdentity,
        r.submit_time                               AS SubmitTime,
        DATEDIFF(second, r.start_time, r.end_time)  AS DurationSec,
        r.command                                   AS QueryText,
        r.status                                    AS Status
    FROM sys.dm_pdw_exec_requests r
    JOIN sys.dm_pdw_exec_sessions s ON r.session_id = s.session_id
    WHERE r.start_time >= DATEADD(
        {'hour' if hours_lookback > 0 else 'day'},
        -{hours_lookback if hours_lookback > 0 else days_lookback},
        GETDATE()
    )
) AS logs
"""

dedicated_dfs = []
is_dedicated_scope = v_name == "All" or (
    "dedicated" in v_name.lower() and v_name != "Built-in (Serverless)"
)

if is_dedicated_scope:
    for cfg in teams_config:
        if v_name != "All" and v_name != cfg["pool"]:
            continue
        jdbc_url = (
            f"jdbc:sqlserver://{synapse_sql_endpoint}:1433;"
            f"database={cfg['pool']};loginTimeout=5;"
        )
        print(f" -> Accessing DMVs: {cfg['pool']}...")
        try:
            tmp_df = (
                spark.read.format("jdbc")
                .option("url", jdbc_url)
                .option("dbtable", dedicated_dmv_query)
                .option("accessToken", token)
                .option("fetchsize", 100)
                .option("truncate", "false")
                .load()
                .withColumn("PoolName",         F.lit(cfg["pool"]))
                .withColumn("PoolType",         F.lit("Dedicated"))
                .withColumn("DataProcessedGB",  F.lit(None).cast(DoubleType()))
                .withColumn("EstimatedCostUSD", F.lit(None).cast(DoubleType()))
                .select(
                    "ReqId", "UserIdentity", "SubmitTime", "DurationSec",
                    "QueryText", "Status", "PoolType", "PoolName",
                    "DataProcessedGB", "EstimatedCostUSD"
                )
            )
            dedicated_dfs.append(tmp_df)
        except:
            pass

master_dedicated_df = dedicated_dfs[0] if dedicated_dfs else spark.createDataFrame([], schema_template)
for next_df in dedicated_dfs[1:]:
    master_dedicated_df = master_dedicated_df.unionByName(next_df)

# ============================================================
# PHASE B: SERVERLESS — RAW ADLS JSON LOG INGESTION
# ============================================================
master_serverless_df = spark.createDataFrame([], schema_template)
is_serverless_scope = v_name in ("All", "Built-in (Serverless)")

if is_serverless_scope:
    print(" -> Scanning Serverless ADLS JSON Log Path...")
    try:
        base_storage_path = (
            "abfss://insights-logs-builtinsqlreqsended"
            "@sasdlc1zpii01psynpeacx02.dfs.core.windows.net"
            "/resourceId=/SUBSCRIPTIONS/0A03E58F-29BD-4793-988F-F25C58CC7E1E"
            "/RESOURCEGROUPS/RG-CUS-SYNPEACX-PROD-01"
            "/PROVIDERS/MICROSOFT.SYNAPSE"
            "/WORKSPACES/SYNW-SYNPEACX"
            "/y=*/m=*/d=*/h=*/m=*/PT1H.json"
        )

        raw_storage_df = spark.read.json(base_storage_path)

        # Uncomment to find correct query text field — paste output and I'll fix it
        # raw_storage_df.select("properties.*").printSchema()

        cutoff_expr = (
            f"current_timestamp() - INTERVAL {hours_lookback} HOURS"
            if hours_lookback > 0 else
            f"current_timestamp() - INTERVAL {days_lookback} DAYS"
        )

        filtered_raw = raw_storage_df.filter(
            F.col("properties.startTime").cast(TimestampType()) >= F.expr(cutoff_expr)
        )

        row_count = filtered_raw.count()
        print(f"    Raw rows in time window: {row_count}")

        master_serverless_df = (
            filtered_raw
            .select(
                F.col("properties.clientRequestId").alias("ReqId"),
                F.col("identity.loginName").alias("UserIdentity"),
                F.col("properties.startTime").cast(TimestampType()).alias("SubmitTime"),
                F.when(
                    F.col("properties.endTime").isNull() | F.col("properties.startTime").isNull(),
                    F.lit(0)
                ).otherwise(
                    F.unix_timestamp(F.col("properties.endTime").cast(TimestampType()))
                    - F.unix_timestamp(F.col("properties.startTime").cast(TimestampType()))
                ).cast(LongType()).alias("DurationSec"),
                # Using properties.command same as your old working query
                # If this still returns one word, uncomment printSchema above
                # and share output so we can find the full text field
                F.coalesce(
										F.trim(F.col("properties.queryText")),
								    F.trim(F.col("properties.command")),
								    F.lit("QUERY TEXT UNAVAILABLE")
								).alias("QueryText"),

                F.when(
                    F.col("properties.error").isNotNull(), F.lit("Failed")
                ).otherwise(F.lit("Completed")).alias("Status"),
                F.col("properties.dataProcessedBytes").cast(LongType()).alias("Bytes")
            )
            .withColumn("PoolType", F.lit("Serverless"))
            .withColumn("PoolName", F.lit("Built-in (Serverless)"))
            .withColumn("DataProcessedGB",
                F.round(F.col("Bytes") / (1024.0 * 1024.0 * 1024.0), 3)
            )
            .withColumn("EstimatedCostUSD",
                F.round(F.col("DataProcessedGB") * 0.0048828, 6)
            )
            .drop("Bytes")
            .select(
                "ReqId", "UserIdentity", "SubmitTime", "DurationSec",
                "QueryText", "Status", "PoolType", "PoolName",
                "DataProcessedGB", "EstimatedCostUSD"
            )
        )

        user_count = master_serverless_df.select("UserIdentity").distinct().count()
        print(f"    [OK] Serverless loaded — {row_count} rows | {user_count} distinct users found.")

    except Exception as e:
        print(f"    [Note] Serverless ADLS path unavailable or empty: {e}")

# ============================================================
# PHASE C: UNION + POOL NAME FILTER + CACHE
# ============================================================
raw_master_df = master_dedicated_df.unionByName(master_serverless_df)

base_filtered_df = raw_master_df.filter(
    F.col("PoolName").isin([v_name]) if v_name != "All" else F.lit(True)
)

base_filtered_df.cache()

