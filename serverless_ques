# ============================================================
# PHASE B: SERVERLESS — RAW ADLS JSON LOG INGESTION
# ============================================================
master_serverless_df = spark.createDataFrame([], schema_template)
is_serverless_scope = v_name in ("All", "Built-in (Serverless)")

if is_serverless_scope:
    print(" -> Scanning Serverless ADLS JSON Log Path...")
    try:
        base_storage_path = (
            "abfss://insights-logs-builtinsqlreqsended"
            "@sasdlc1zpii01psynpeacx02.dfs.core.windows.net"
            "/resourceId=/SUBSCRIPTIONS/0A03E58F-29BD-4793-988F-F25C58CC7E1E"
            "/RESOURCEGROUPS/RG-CUS-SYNPEACX-PROD-01"
            "/PROVIDERS/MICROSOFT.SYNAPSE"
            "/WORKSPACES/SYNW-SYNPEACX"
            "/y=*/m=*/d=*/h=*/m=*/PT1H.json"
        )

        # Read exactly like your old query — full glob, no options
        raw_storage_df = spark.read.json(base_storage_path)

        # Time filter using the lookback window
        cutoff_expr = (
            f"current_timestamp() - INTERVAL {hours_lookback} HOURS"
            if hours_lookback > 0 else
            f"current_timestamp() - INTERVAL {days_lookback} DAYS"
        )

        filtered_raw = raw_storage_df.filter(
            F.col("properties.startTime").cast(TimestampType()) >= F.expr(cutoff_expr)
        )

        row_count = filtered_raw.count()
        print(f"    Raw rows in time window: {row_count}")

        master_serverless_df = (
            filtered_raw
            .select(
                F.col("properties.clientRequestId").alias("ReqId"),
                F.col("identity.loginName").alias("UserIdentity"),
                F.col("properties.startTime").cast(TimestampType()).alias("SubmitTime"),

                # Duration null-safe
                F.when(
                    F.col("properties.endTime").isNull() | F.col("properties.startTime").isNull(),
                    F.lit(0)
                ).otherwise(
                    F.unix_timestamp(F.col("properties.endTime").cast(TimestampType()))
                    - F.unix_timestamp(F.col("properties.startTime").cast(TimestampType()))
                ).cast(LongType()).alias("DurationSec"),

                # Use properties.command exactly like your old query
                F.coalesce(
                    F.trim(F.col("properties.command")),
                    F.lit("MALFORMED SCRIPT / INSTANT PARSE FAILURE")
                ).alias("QueryText"),

                F.when(
                    F.col("properties.error").isNotNull(), F.lit("Failed")
                ).otherwise(F.lit("Completed")).alias("Status"),

                F.col("properties.dataProcessedBytes").cast(LongType()).alias("Bytes")
            )
            .withColumn("PoolType", F.lit("Serverless"))
            .withColumn("PoolName", F.lit("Built-in (Serverless)"))
            .withColumn("DataProcessedGB",
                F.round(F.col("Bytes") / (1024.0 * 1024.0 * 1024.0), 3)
            )
            .withColumn("EstimatedCostUSD",
                F.round(F.col("DataProcessedGB") * 0.0048828, 6)
            )
            .drop("Bytes")
            .select(
                "ReqId", "UserIdentity", "SubmitTime", "DurationSec",
                "QueryText", "Status", "PoolType", "PoolName",
                "DataProcessedGB", "EstimatedCostUSD"
            )
        )

        user_count = master_serverless_df.select("UserIdentity").distinct().count()
        print(f"    [OK] Serverless loaded — {row_count} rows | {user_count} distinct users found.")

    except Exception as e:
        print(f"    [Note] Serverless ADLS path unavailable or empty: {e}")
