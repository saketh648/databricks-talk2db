SynapseBuiltinSqlPoolRequestsEnded
| where TimeGenerated {TimeRange}
| extend props = parse_json(tostring(Properties))
| extend Bytes = todouble(props.dataProcessedBytes)
// Convert Bytes to TB and multiply by $5.00
| extend Cost = (Bytes / (1024.0 * 1024.0 * 1024.0 * 1024.0)) * 5.00
| summarize 
    ["Total Spend (USD)"] = strcat("$", round(sum(Cost), 2)),
    ["Data Scanned (GB)"] = round(sum(Bytes / (1024.0 * 1024.0 * 1024.0)), 2)


SynapseBuiltinSqlPoolRequestsEnded
| where TimeGenerated {TimeRange}
| extend props = parse_json(tostring(Properties))
| extend Cost = (todouble(props.dataProcessedBytes) / (1024.0 * 1024.0 * 1024.0 * 1024.0)) * 5.00
| summarize Spend = sum(Cost) by Identity
| order by Spend desc



SynapseBuiltinSqlPoolRequestsEnded
| where TimeGenerated {TimeRange}
| extend props = parse_json(tostring(Properties))
| extend 
    Bytes = todouble(props.dataProcessedBytes),
    SQL = tostring(props.queryText),
    DurationSec = datetime_diff('second', datetime(props.endTime), datetime(props.startTime))
| extend CostUSD = (Bytes / (1024.0 * 1024.0 * 1024.0 * 1024.0)) * 5.00
| project 
    TimeGenerated, 
    Identity, 
    CostUSD = round(CostUSD, 4), 
    DataMB = round(Bytes / 1024 / 1024, 2),
    DurationSec,
    SQL
| order by CostUSD desc

