from pyspark.sql import functions as F
from pyspark.sql.types import *
import ipywidgets as widgets
from IPython.display import display as ipydisplay

spark.conf.set("spark.sql.debug.maxToStringFields", "5000")

# Capture values
v_name = pool_name_w.value
v_time = time_filter_w.value

days_lookback = 1; hours_lookback = 0
if v_time == "Past 1 Hour":    days_lookback = 0; hours_lookback = 1
elif v_time == "Past 4 Hours": days_lookback = 0; hours_lookback = 4
elif v_time == "Past 3 Days":  days_lookback = 3; hours_lookback = 0

print(f"🚀 Initializing Extraction -> Pool={v_name} | Lookback={v_time}...\n")

token = mssparkutils.credentials.getToken("DW")
synapse_sql_endpoint = "synw-synpeacx.sql.azuresynapse.net"

teams_config = [
    {"team": "Care Team",                "pool": "Care_dev_dedicated"},
    {"team": "Operations Team",          "pool": "ac_operations__dev_dedicated_new"},
    {"team": "WCIB Corporate Team",      "pool": "wcib_dev_dedicated"},
    {"team": "Operations Team",          "pool": "operations_and_enterprise_prod_dedicated"},
    {"team": "Marketing Data Team",      "pool": "marketing_data_products_prod_dedicated"},
    {"team": "Marketing Act Team",       "pool": "marketing_activation_dev_dedicated"},
    {"team": "Special Projects Team",    "pool": "special_projects__dev_dedicated"},
    {"team": "Operations Team",          "pool": "operations_and_enterprise_dev_dedicated"},
    {"team": "Marketing Analyt Team",    "pool": "marketing_analytics__prod_dedicated"},
    {"team": "Care Team",                "pool": "care_prod_dedicated"},
    {"team": "Digital Product Team",     "pool": "digital_prod_dedicated"},
    {"team": "Marketing Analyt Team",    "pool": "marketing_analytics_dev_dedicated"},
    {"team": "Digital Product Team",     "pool": "digital_dev_dedicated"},
    {"team": "Location Analyt Team",     "pool": "locations_analytics_prod_dedicated"},
    {"team": "WCIB Corporate Team",      "pool": "wcib_prod_dedicated"}
]

schema_template = StructType([
    StructField("ReqId",            StringType(),    True),
    StructField("UserIdentity",     StringType(),    True),
    StructField("SubmitTime",       TimestampType(), True),
    StructField("DurationSec",      LongType(),      True),
    StructField("QueryText",        StringType(),    True),
    StructField("Status",           StringType(),    True),
    StructField("PoolType",         StringType(),    True),
    StructField("PoolName",         StringType(),    True),
    StructField("TeamName",         StringType(),    True),
    StructField("DataProcessedGB",  DoubleType(),    True),
    StructField("EstimatedCostUSD", DoubleType(),    True)
])

# --- PHASE A: DEDICATED POOLS ---
dedicated_dmv_query = f"""
(
    SELECT 
        r.request_id                                        AS ReqId,
        s.login_name                                        AS UserIdentity,
        r.submit_time                                       AS SubmitTime,
        DATEDIFF(second, r.start_time, r.end_time)          AS DurationSec,
        r.command                                           AS QueryText,
        r.status                                            AS Status
    FROM sys.dm_pdw_exec_requests r
    JOIN sys.dm_pdw_exec_sessions s ON r.session_id = s.session_id
    WHERE r.start_time >= DATEADD(
        {'hour' if hours_lookback > 0 else 'day'},
        -{hours_lookback if hours_lookback > 0 else days_lookback},
        GETDATE()
    )
) AS logs
"""

dedicated_dfs = []
is_dedicated_scope = v_name == "All" or ("dedicated" in v_name.lower() and v_name != "Built-in (Serverless)")

if is_dedicated_scope:
    for cfg in teams_config:
        if v_name != "All" and v_name != cfg["pool"]:
            continue
        jdbc_url = f"jdbc:sqlserver://{synapse_sql_endpoint}:1433;database={cfg['pool']};loginTimeout=5;"
        print(f" -> Accessing DMVs: {cfg['pool']}...")
        try:
            tmp_df = (spark.read.format("jdbc")
                      .option("url", jdbc_url)
                      .option("dbtable", dedicated_dmv_query)
                      .option("accessToken", token)
                      .load()
                      .withColumn("TeamName",         F.lit(cfg["team"]))
                      .withColumn("PoolName",         F.lit(cfg["pool"]))
                      .withColumn("PoolType",         F.lit("Dedicated"))
                      .withColumn("DataProcessedGB",  F.lit(None).cast(DoubleType()))   # NULL — not applicable
                      .withColumn("EstimatedCostUSD", F.lit(None).cast(DoubleType())))  # NULL — flat billed
            dedicated_dfs.append(tmp_df)
        except:
            pass

master_dedicated_df = dedicated_dfs[0] if dedicated_dfs else spark.createDataFrame([], schema_template)
for next_df in dedicated_dfs[1:]:
    master_dedicated_df = master_dedicated_df.unionByName(next_df)

# --- PHASE B: SERVERLESS — RAW ADLS JSON LOG INGESTION ---
master_serverless_df = spark.createDataFrame([], schema_template)
is_serverless_scope = v_name in ("All", "Built-in (Serverless)")

if is_serverless_scope:
    print(" -> Scanning Serverless ADLS JSON Log Path...")
    try:
        base_storage_path = (
            "abfss://insights-logs-builtinsqlreqsended"
            "@sasdlc1zpii01psynpeacx02.dfs.core.windows.net"
            "/resourceId=/SUBSCRIPTIONS/0A03E58F-29BD-4793-988F-F25C58CC7E1E"
            "/RESOURCEGROUPS/RG-CUS-SYNPEACX-PROD-01"
            "/PROVIDERS/MICROSOFT.SYNAPSE"
            "/WORKSPACES/SYNW-SYNPEACX"
            "/y=*/m=*/d=*/h=*/m=*/PT1H.json"
        )

        raw_storage_df = spark.read.json(base_storage_path)

        # Build a cutoff timestamp from the lookback window for partition pruning
        cutoff_expr = f"current_timestamp() - INTERVAL {hours_lookback} HOURS" \
                      if hours_lookback > 0 else \
                      f"current_timestamp() - INTERVAL {days_lookback} DAYS"

        master_serverless_df = (
            raw_storage_df
            .filter(
                F.col("properties.startTime").cast(TimestampType()) >= F.expr(cutoff_expr)
            )
            .select(
                F.col("properties.clientRequestId").alias("ReqId"),
                F.col("identity.loginName").alias("UserIdentity"),
                F.col("properties.startTime").cast(TimestampType()).alias("SubmitTime"),

                # Duration: null-safe subtraction
                F.when(
                    F.col("properties.endTime").isNull() | F.col("properties.startTime").isNull(),
                    F.lit(0)
                ).otherwise(
                    F.unix_timestamp(F.col("properties.endTime").cast(TimestampType()))
                    - F.unix_timestamp(F.col("properties.startTime").cast(TimestampType()))
                ).cast(LongType()).alias("DurationSec"),

                F.coalesce(
                    F.trim(F.col("properties.command")),
                    F.lit("MALFORMED SCRIPT / INSTANT PARSE FAILURE")
                ).alias("QueryText"),

                # Derive status from presence of error node
                F.when(
                    F.col("properties.error").isNotNull(), F.lit("Failed")
                ).otherwise(F.lit("Completed")).alias("Status"),

                # Cost columns — convert bytes to GB then price
                F.round(
                    F.col("properties.dataProcessedBytes").cast(LongType()) / (1024*1024*1024), 3
                ).alias("DataProcessedGB"),
            )
            .withColumn("EstimatedCostUSD",
                F.round(F.col("DataProcessedGB") * 0.0048828, 4)
            )
            .withColumn("PoolType",  F.lit("Serverless"))
            .withColumn("PoolName",  F.lit("Built-in (Serverless)"))
            .withColumn("TeamName",  F.lit("Shared Infrastructure"))
        )

        # Cast to schema_template column order for clean unionByName with dedicated
        master_serverless_df = master_serverless_df.select(
            "ReqId", "UserIdentity", "SubmitTime", "DurationSec",
            "QueryText", "Status", "PoolType", "PoolName", "TeamName",
            "DataProcessedGB", "EstimatedCostUSD"
        )

        print(f"    [OK] Serverless logs loaded from ADLS path.")

    except Exception as e:
        print(f"    [Note] Serverless ADLS path unavailable or empty: {e}")

# --- PHASE C: UNION + FILTER (no status filter here — moved to Cell 3) ---
raw_master_df = master_dedicated_df.unionByName(master_serverless_df)

base_filtered_df = raw_master_df.filter(
    F.col("PoolName").isin([v_name]) if v_name != "All" else F.lit(True)
)

base_filtered_df.cache()

unique_users = sorted([
    row["UserIdentity"]
    for row in base_filtered_df.select("UserIdentity").distinct().collect()
    if row["UserIdentity"]
])
unique_users.insert(0, "All")

user_filter_w   = widgets.Dropdown(options=unique_users, value="All", description="View User:")
status_filter_w = widgets.Dropdown(
    options=["All", "Completed", "Failed", "Running"],
    value="All",
    description="Query Status:"
)

print(f"\n--- ✅ Data Cached! {len(unique_users)-1} unique users found. ---")
ipydisplay(user_filter_w)
ipydisplay(status_filter_w)







from pyspark.sql import functions as F

v_user   = user_filter_w.value
v_status = status_filter_w.value

final_dashboard_df = (
    base_filtered_df
    .filter((F.col("UserIdentity") == v_user)  | (F.lit(v_user)   == "All"))
    .filter((F.col("Status").rlike(f"(?i){v_status}")) | (F.lit(v_status) == "All"))
    .orderBy(F.col("SubmitTime").desc())
)

# Summary metrics
total_queries     = final_dashboard_df.count()
avg_exec_time     = final_dashboard_df.select(F.avg("DurationSec")).collect()[0][0] or 0.0
has_serverless    = final_dashboard_df.filter(F.col("PoolType") == "Serverless").count()  > 0
has_dedicated     = final_dashboard_df.filter(F.col("PoolType") == "Dedicated").count()  > 0

print("=" * 85)
print(f" 📊 METRICS CANVAS | USER: {v_user.upper()} | STATUS FILTER: {v_status.upper()} ")
print("=" * 85)
print(f" -> Total Query Volume        : {total_queries}")
print(f" -> Avg Execution Time        : {round(avg_exec_time, 2)} sec")

if has_serverless and not has_dedicated:
    total_cost    = final_dashboard_df.select(F.sum("EstimatedCostUSD")).collect()[0][0] or 0.0
    total_scanned = final_dashboard_df.select(F.sum("DataProcessedGB")).collect()[0][0]  or 0.0
    print(f" -> Data Scanned              : {round(total_scanned, 3)} GB")
    print(f" 💸 Estimated Cost            : ${round(float(total_cost), 4)}")
elif has_dedicated and not has_serverless:
    peak = final_dashboard_df.select(F.max("DurationSec")).collect()[0][0] or 0
    print(f" 🚀 Peak Query Runtime        : {peak} sec")
    print(f" [Note] Dedicated pools are flat-billed — no per-query cost.")
else:
    cost = final_dashboard_df.filter(F.col("PoolType") == "Serverless").select(F.sum("EstimatedCostUSD")).collect()[0][0] or 0.0
    print(f" 💸 Serverless Cost (blended) : ${round(float(cost), 4)}")
    print(f" [Info] Mixed view — isolate a pool for precise metrics.")

print("=" * 85 + "\n")

# --- COLUMN STRATEGY: drop cost columns for dedicated-only, keep for serverless/mixed ---
# For QueryText: Spark's display() truncates by default — we force full text via a workaround
# by converting to pandas for rendering (only viable if row count is reasonable)

display_cols = ["ReqId", "UserIdentity", "SubmitTime", "DurationSec", "QueryText", "Status", "PoolType", "PoolName", "TeamName"]

if has_serverless:
    display_cols += ["DataProcessedGB", "EstimatedCostUSD"]

# Truncate QueryText to 2000 chars so the cell renders cleanly without losing substance
output_df = (
    final_dashboard_df
    .withColumn("QueryText", F.substring(F.col("QueryText"), 1, 2000))
    .select(*display_cols)
)

# Full text display fix: set Spark SQL display truncation off for this cell
spark.conf.set("spark.sql.repl.eagerEval.truncate", "2000")

display(output_df)
