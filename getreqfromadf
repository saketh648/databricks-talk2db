union 
(SynapseBuiltinSqlPoolRequestsEnded | project EntityName = tostring(Properties.databaseName)),
(SynapseSqlPoolSqlRequests | project EntityName = ResourceGroupName_s), // Captures Dedicated Pools
(SynapseSparkApplications | project EntityName = SparkPoolName) // Captures Spark Teams
| summarize by EntityName
| where isnotempty(EntityName)
| order by EntityName asc
