SynapseBuiltinSqlPoolRequestsEnded
| where TimeGenerated > ago(30d)
| extend props = parse_json(tostring(Properties))
// If databaseName isn't there, we'll use 'Builtin' as a fallback
| extend DB = coalesce(tostring(props.databaseName), "Built-in Pool")
| summarize by DB
| project value = DB, label = DB
