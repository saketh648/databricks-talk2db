SynapseBuiltinSqlPoolRequestsEnded
| summarize by tostring(Properties.poolName)
| project value = Properties_poolName, label = Properties_poolName




SynapseBuiltinSqlPoolRequestsEnded
| where TimeGenerated > ago(24h)
| summarize 
    TotalQueries = count(), 
    LatestRun = max(TimeGenerated) 
    by PoolName = tostring(Properties.poolName)
| order by TotalQueries desc


SynapseBuiltinSqlPoolRequestsEnded
| where TimeGenerated > ago(24h)
| take 5
| project Properties


SynapseBuiltinSqlPoolRequestsEnded
| where TimeGenerated > ago(24h)
| extend pName = coalesce(
    tostring(Properties.poolName), 
    tostring(Properties.PoolName), 
    tostring(Properties.pool),
    "Unknown Pool"
)
| summarize by pName
| project value = pName, label = pName


