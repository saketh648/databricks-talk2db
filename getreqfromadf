SynapseBuiltinSqlPoolRequestsEnded
| where TimeGenerated {TimeRange}
| extend props = parse_json(tostring(Properties))
| extend Cost = (todouble(props.dataProcessedBytes) / (1024.0 * 1024.0 * 1024.0 * 1024.0)) * 5.00
// Explicitly cast Identity to string
| extend UserIdentity = tostring(Identity) 
| extend UserIdentity = iif(isempty(UserIdentity), "System/Automated", UserIdentity)
| summarize Spend = sum(Cost) by UserIdentity
| where Spend > 0
| order by Spend desc



SynapseBuiltinSqlPoolRequestsEnded
| where TimeGenerated {TimeRange}
| extend props = parse_json(tostring(Properties))
| extend 
    Bytes = todouble(props.dataProcessedBytes),
    SQL = tostring(props.queryText),
    // Explicitly cast to string before converting to datetime
    Start = todatetime(tostring(props.startTime)),
    End = todatetime(tostring(props.endTime))
| extend 
    DurationSec = datetime_diff('second', End, Start),
    CostUSD = round((Bytes / (1024.0 * 1024.0 * 1024.0 * 1024.0)) * 5.00, 4),
    User = tostring(Identity)
| project 
    TimeGenerated, 
    User = iif(isempty(User), "System", User), 
    CostUSD, 
    DataMB = round(Bytes / 1024 / 1024, 2),
    DurationSec,
    SQL
| where Bytes > 0
| order by TimeGenerated desc
