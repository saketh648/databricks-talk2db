# Check what the index actually has for a known case
from databricks.vector_search.client import VectorSearchClient

vsc = VectorSearchClient()
index = vsc.get_index(
    endpoint_name="talk2db_poc_endpoint",
    index_name="dev.er_sp_metadata.spg_entity_master_index"
)

# Test Encova — spgid19 says 1671565742 but we're getting 688034980
result = index.similarity_search(
    query_text="Encova Insurance",
    columns=["childcompanyname", "childcompanyid"],
    num_results=5
)
print("=== Encova Insurance ===")
for r in result.get("result", {}).get("data_array", []):
    print(f"  {r[0]} | childcompanyid={int(float(r[1]))} | score={r[2]:.4f}")

