# ============================================================
# GENERIC ENTERPRISE ENTITY RESOLUTION PIPELINE - V6
# Fixes:
#   - party_id regex: digits immediately concat with name, no separator
#   - Score thresholds recalibrated: index returns 0.55-0.65 range
#   - Fallback threshold lowered to 63 (boosted score, ~0.60 raw * 1.05)
#   - LLM prompt relaxed: penalize over-refusal, reward best-fit matching
#   - LLM given raw_score context so it can weigh confidence itself
#   - Truncated name guard: flag short/fragment names before vector search
# ============================================================

import pandas as pd
import pyspark.sql.functions as F
from pyspark.sql.types import *
from databricks.vector_search.client import VectorSearchClient

# ============================================================
# CONFIGURATION
# ============================================================

CONFIG = {
    # Vector Search
    "vector_endpoint":  "talk2db_poc_endpoint",
    "vector_index":     "dev.er_sp_metadata.spg_entity_master_index",
    "vector_name_col":  "childcompanyname",
    "vector_id_col":    "childcompanyid",
    "vector_top_k":     15,

    # LLM
    "llm_model":        "databricks-llama-4-maverick",
    "llm_max_tokens":   200,
    "llm_temperature":  0,

    # Scoring
    # Index returns cosine similarity 0.55-0.65, multiplied by 100 = 55-65
    # Boosts up to 1.2x bring max to ~78
    # Fallback fires when LLM says UNMATCHED but vector score is strong
    "score_boost_exact":   1.2,
    "score_boost_partial": 1.1,
    "score_boost_reverse": 1.05,
    "score_fallback_min":  63.0,   # ~0.60 raw * 1.05 boost — conservative but reachable

    # Parallelism
    "vector_partitions": 60,
    "llm_partitions":    120,

    # Sources
    "sources": [
        {
            "table":             "dev.mma_entityresolution.tbl_entityres_ach_rec_names_match_kensho",
            "name_col":          "party_id",
            "id_col":            "sor_id",
            "pass_through_cols": ["spgid19"],
            "output_table":      "entity_resolution_ach_received_kensho_resolved",
        }
    ],

    "output_database": "dev.mma_entityresolution",

    # FIX: party_id format is digits immediately concatenated with name, no separator
    # e.g. "0000153564238308LAKE WASHINGTON ELECTR"
    # Pattern: strip all leading digits, whatever remains is the name
    "party_id_pattern": r"^\d+(.+)$",

    # Legal suffix / prefix cleaning
    "strip_prefix_pattern": r"^(#[A-Z0-9]+\s+)",
    "strip_suffix_pattern": r"(?i)\b(LLC|INC|CORP|LTD|SERVICES|S\.P\.A|B\.V|K\.K|DEFAULT|APP|APPS|PLATFORM|PAYMENT|PAYMENTS|PAY|AACH_REC|ACH_REC)\b",

    "min_name_length":    3,
    "max_digit_fraction": 0.6,

    # Names shorter than this after cleaning are likely truncated fragments — skip LLM, mark as fragment
    "min_meaningful_length": 5,
}

# ============================================================
# STEP 1: PARSING & CLEANING
# ============================================================

def normalize(df, name_col, id_col, pass_through_cols):
    select_cols = [F.col(id_col).alias("sor_id")] + [F.col(c) for c in pass_through_cols]

    return (
        df
        .withColumn("src_company_name_raw", F.col(name_col))

        # FIX: strip all leading digits directly — no separator assumption
        .withColumn("_raw_text_extracted",
            F.regexp_extract(F.col(name_col), CONFIG["party_id_pattern"], 1)
        )
        .withColumn("_raw_text",
            F.when(F.col("_raw_text_extracted") == "", F.col(name_col))
             .otherwise(F.col("_raw_text_extracted"))
        )

        # Clean noise
        .withColumn("_upper",    F.upper(F.trim(F.col("_raw_text"))))
        .withColumn("_stripped", F.trim(F.regexp_replace(F.col("_upper"), CONFIG["strip_prefix_pattern"], "")))
        .withColumn("_denoised", F.trim(F.regexp_replace(F.col("_stripped"), CONFIG["strip_suffix_pattern"], "")))

        # Final cleaned forms
        .withColumn("name_clean",   F.initcap(F.trim(F.col("_denoised"))))
        .withColumn("name_keyword", F.initcap(F.trim(F.regexp_extract(F.col("_denoised"), r"^(\S+)", 1))))

        # Flag fragments — names too short to be meaningful after cleaning
        .withColumn("is_fragment",
            F.when(F.length(F.trim(F.col("name_clean"))) < CONFIG["min_meaningful_length"], F.lit(True))
             .otherwise(F.lit(False))
        )

        .select(*select_cols, "src_company_name_raw", "name_clean", "name_keyword", "is_fragment")
    )

# ============================================================
# STEP 2: VECTOR SEARCH
# Index returns: r[0]=childcompanyname(str), r[1]=childcompanyid(float), r[2]=score(float)
# childcompanyid is float in index — cast to int string
# spgid19 is NOT in index — passed through from source only
# ============================================================

result_schema = StructType([
    StructField("name_clean",          StringType(), True),
    StructField("name_keyword",        StringType(), True),
    StructField("candidates_json",     StringType(), True),
    StructField("raw_vector_score",    FloatType(),  True),
    StructField("top_candidate_name",  StringType(), True),
    StructField("top_candidate_id",    StringType(), True),
])

def is_valid_name(name: str, max_digit_fraction: float) -> bool:
    if not name or len(name.strip()) < 2:
        return False
    digit_ratio = sum(c.isdigit() for c in name) / len(name)
    return digit_ratio < max_digit_fraction

def make_vector_worker(cfg: dict):
    endpoint       = cfg["vector_endpoint"]
    index_name     = cfg["vector_index"]
    name_col       = cfg["vector_name_col"]
    id_col         = cfg["vector_id_col"]
    top_k          = cfg["vector_top_k"]
    boost_exact    = cfg["score_boost_exact"]
    boost_partial  = cfg["score_boost_partial"]
    boost_reverse  = cfg["score_boost_reverse"]
    max_digit_frac = cfg["max_digit_fraction"]

    def worker(iterator):
        import json
        vsc   = VectorSearchClient()
        index = vsc.get_index(endpoint_name=endpoint, index_name=index_name)

        for pdf in iterator:
            results = []
            for _, row in pdf.iterrows():
                name_clean   = str(row["name_clean"])   if row["name_clean"]   else ""
                name_keyword = str(row["name_keyword"]) if row["name_keyword"] else ""

                try:
                    # Primary: full cleaned name
                    r1 = index.similarity_search(
                        query_text=name_clean,
                        columns=[name_col, id_col],
                        num_results=top_k
                    ).get("result", {}).get("data_array", [])

                    # Secondary: first keyword only
                    r2 = []
                    if name_keyword and name_keyword.lower() != name_clean.lower():
                        r2 = index.similarity_search(
                            query_text=name_keyword,
                            columns=[name_col, id_col],
                            num_results=top_k
                        ).get("result", {}).get("data_array", [])

                    kw_upper   = name_keyword.upper()
                    full_upper = name_clean.upper()
                    seen: dict = {}

                    for data, weight in [(r1, 1.0), (r2, 0.95)]:
                        for r in data:
                            c_name = str(r[0]).strip()
                            # childcompanyid comes as float e.g. 45730511.0 — normalize
                            c_id   = str(int(float(r[1]))) if r[1] is not None else ""
                            v_score = float(r[2])   # confirmed at index 2

                            if not is_valid_name(c_name, max_digit_frac):
                                continue

                            c_upper = c_name.upper()
                            if kw_upper and kw_upper in c_upper:
                                boost = boost_exact
                            elif full_upper and full_upper in c_upper:
                                boost = boost_partial
                            elif kw_upper and c_upper in kw_upper:
                                boost = boost_reverse
                            else:
                                boost = 1.0

                            raw_score_pct = round(v_score * 100, 2)
                            final_score   = round(raw_score_pct * boost * weight, 2)

                            if c_name not in seen or final_score > seen[c_name]["score"]:
                                seen[c_name] = {
                                    "score":     final_score,
                                    "raw_score": raw_score_pct,
                                    "id":        c_id,
                                }

                    processed = sorted(
                        [
                            {
                                "name":      n,
                                "id":        info["id"],
                                "score":     info["score"],
                                "raw_score": info["raw_score"],
                            }
                            for n, info in seen.items()
                        ],
                        key=lambda x: x["score"],
                        reverse=True
                    )[:5]

                    top = processed[0] if processed else None

                    results.append({
                        "name_clean":         name_clean,
                        "name_keyword":       name_keyword,
                        "candidates_json":    json.dumps(processed),
                        "raw_vector_score":   float(top["score"]) if top else 0.0,
                        "top_candidate_name": top["name"]         if top else "",
                        "top_candidate_id":   top["id"]           if top else "",
                    })

                except Exception as e:
                    results.append({
                        "name_clean":         name_clean,
                        "name_keyword":       name_keyword,
                        "candidates_json":    json.dumps([{"error": str(e)}]),
                        "raw_vector_score":   0.0,
                        "top_candidate_name": "",
                        "top_candidate_id":   "",
                    })

            yield pd.DataFrame(results)
    return worker

# ============================================================
# STEP 3: LLM PROMPT
# Relaxed from V5 — UNMATCHED only when truly ambiguous
# LLM receives raw_score to weigh confidence
# Instructed to pick best-fit even on partial/abbreviated names
# ============================================================

def build_prompt_column():
    return F.concat_ws("",
        F.lit("You are an enterprise entity resolution assistant matching ACH payment company names to a master S&P entity index.\n\n"),
        F.lit("RAW NAME: "),          F.col("name_clean"),
        F.lit("\nTOP SCORE: "),       F.col("raw_vector_score").cast("string"),
        F.lit("\nCANDIDATES: "),      F.col("candidates_json"),
        F.lit(
            "\n\nINSTRUCTIONS:\n"
            "1. RAW NAME is from ACH payment data and may be abbreviated or truncated — this is expected.\n"
            "2. Match to the single best candidate that most plausibly refers to the same real-world organization.\n"
            "3. Abbreviated names (e.g. 'US Bank NA' → 'U.S. Bank, NA') and partial names are valid matches.\n"
            "4. Do NOT require an exact or complete name match — use business judgment.\n"
            "5. Only output UNMATCHED if no candidate is even remotely plausible for this organization.\n"
            "6. Extract the exact candidate name and its 'id' field from the JSON.\n\n"
            "OUTPUT FORMAT — respond with exactly this structure and nothing else:\n"
            "[MATCH]: <exact candidate name or UNMATCHED> | [MATCHED_ID]: <id value or BLANK> | [REASON]: <one sentence>"
        )
    )

# ============================================================
# STEP 4: EXECUTION PIPELINE
# ============================================================

def run_pipeline(cfg: dict):
    spark.catalog.clearCache()

    # 4a. Normalize sources
    source_dfs = []
    for src in cfg["sources"]:
        df = normalize(
            spark.table(src["table"]),
            name_col=src["name_col"],
            id_col=src["id_col"],
            pass_through_cols=src["pass_through_cols"]
        )
        source_dfs.append((src, df))

    # 4b. Deduplicated name registry — skip fragments
    all_dfs = [d for _, d in source_dfs]
    search_registry = all_dfs[0].select("name_clean", "name_keyword", "is_fragment")
    for extra_df in all_dfs[1:]:
        search_registry = search_registry.union(
            extra_df.select("name_clean", "name_keyword", "is_fragment")
        )

    search_registry = search_registry.distinct().filter(
        F.col("name_clean").isNotNull() &
        (F.length(F.trim(F.col("name_clean"))) >= cfg["min_name_length"]) &
        (F.col("is_fragment") == False)   # skip fragments from vector search
    )

    # 4c. Vector similarity phase
    vector_worker = make_vector_worker(cfg)
    registry_matches = (
        search_registry
        .repartition(cfg["vector_partitions"])
        .mapInPandas(vector_worker, schema=result_schema)
        .cache()
    )

    # 4d. LLM invocation
    answer_key = (
        registry_matches
        .withColumn("prompt", build_prompt_column())
        .repartition(cfg["llm_partitions"])
        .withColumn(
            "llm_raw",
            F.expr(
                f"ai_query('{cfg['llm_model']}', prompt, "
                f"map('max_tokens', '{cfg['llm_max_tokens']}', 'temperature', '{cfg['llm_temperature']}'))"
            )
        )
        .cache()
    )

    # 4e. Compile and write output
    for src_meta, df_clean in source_dfs:

        df_final = (
            df_clean
            .join(registry_matches, on="name_clean", how="left")
            .join(answer_key.select("name_clean", "llm_raw"), on="name_clean", how="left")
        )

        # Parse LLM output
        df_final = (
            df_final
            .withColumn("llm_name",
                F.trim(F.regexp_replace(
                    F.regexp_extract("llm_raw", r"\[MATCH\]:\s*([^|]+)", 1),
                    r"[\*\[\]\"']", ""
                ))
            )
            .withColumn("llm_id",
                F.trim(F.regexp_replace(
                    F.regexp_extract("llm_raw", r"\[MATCHED_ID\]:\s*([^|]+)", 1),
                    r"[\*\[\]\"']", ""
                ))
            )
            .withColumn("match_explanation",
                F.trim(F.regexp_extract("llm_raw", r"\[REASON\]:\s*(.*)", 1))
            )
        )

        # Resolution: LLM → vector fallback → fragment → No Clear Match
        df_final = (
            df_final
            .withColumn(
                "childcompanyname",
                F.when(F.col("is_fragment"), F.lit("FRAGMENT - NAME TOO SHORT"))
                 .when(
                    F.col("llm_name").isNotNull() &
                    (F.upper(F.trim(F.col("llm_name"))) != "UNMATCHED") &
                    (F.trim(F.col("llm_name")) != ""),
                    F.col("llm_name")
                 ).when(
                    (F.col("raw_vector_score") >= cfg["score_fallback_min"]) &
                    F.col("top_candidate_name").isNotNull() &
                    (F.trim(F.col("top_candidate_name")) != ""),
                    F.col("top_candidate_name")
                 ).otherwise(F.lit("No Clear Match"))
            )
            .withColumn(
                "childcompanyid",
                F.when(F.col("is_fragment"), F.lit(None).cast(StringType()))
                 .when(
                    F.col("llm_name").isNotNull() &
                    (F.upper(F.trim(F.col("llm_name"))) != "UNMATCHED") &
                    (F.trim(F.col("llm_name")) != ""),
                    F.col("llm_id")
                 ).when(
                    (F.col("raw_vector_score") >= cfg["score_fallback_min"]) &
                    F.col("top_candidate_name").isNotNull() &
                    (F.trim(F.col("top_candidate_name")) != ""),
                    F.col("top_candidate_id")
                 ).otherwise(F.lit(None).cast(StringType()))
            )
            .withColumn(
                "match_method",
                F.when(F.col("is_fragment"), F.lit("FRAGMENT"))
                 .when(
                    F.col("llm_name").isNotNull() &
                    (F.upper(F.trim(F.col("llm_name"))) != "UNMATCHED") &
                    (F.trim(F.col("llm_name")) != ""),
                    F.lit("LLM")
                 ).when(
                    (F.col("raw_vector_score") >= cfg["score_fallback_min"]) &
                    F.col("top_candidate_name").isNotNull(),
                    F.lit("VECTOR_FALLBACK")
                 ).otherwise(F.lit("NO_MATCH"))
            )
        )

        # Output schema
        # spgid19       = Kensho ground truth from source (comparison only, not used in matching)
        # childcompanyid = pipeline resolved ID (goal: match spgid19)
        # candidates_json = full vector candidates (remove in prod)
        final_cols = [
            "sor_id",
            "src_company_name_raw",
            "name_clean",
            "childcompanyname",
            "childcompanyid",
            "spgid19",            # Kensho ground truth — for accuracy comparison only
            "raw_vector_score",
            "match_method",
            "match_explanation",
            "candidates_json",    # diagnostic — remove in prod
        ]

        out_table = f"{cfg['output_database']}.{src_meta['output_table']}"
        (
            df_final.select(final_cols)
            .write.format("delta")
            .mode("overwrite")
            .option("overwriteSchema", "true")
            .saveAsTable(out_table)
        )
        print(f"✅ Saved to: {out_table}")

# ============================================================
# ENTRY POINT
# ============================================================
run_pipeline(CONFIG)


