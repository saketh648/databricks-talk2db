from databricks.vector_search.client import VectorSearchClient

vsc = VectorSearchClient()
index = vsc.get_index(
    endpoint_name="talk2db_poc_endpoint",
    index_name="dev.er_sp_metadata.spg_entity_master_index"
)

# Test names that came back as No Clear Match
test_names = [
    "Innovative Engineering",
    "North Salt Lake Water",
    "Truebill",
    "Golden Hearts",
    "Neal Insurance",
]

for name in test_names:
    result = index.similarity_search(
        query_text=name,
        columns=["childcompanyname", "childcompanyid"],
        num_results=3
    )
    rows = result.get("result", {}).get("data_array", [])
    print(f"\n--- {name} ---")
    for r in rows:
        print(f"  {r[0]} | id={int(float(r[1]))} | score={r[2]:.4f}")
