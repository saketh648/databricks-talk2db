from databricks.vector_search.client import VectorSearchClient

vsc = VectorSearchClient()
index = vsc.get_index(
    endpoint_name="talk2db_poc_endpoint",
    index_name="dev.er_sp_metadata.spg_entity_master_index"
)

tests = {
    "Horizons At Stonebridg": 29622020,
    "Industrial Training":    608731212,
    "Happy Garden":           566325189,
    "Hampton Inn Nashville":  643897773,
}

for name, target_spgid in tests.items():
    result = index.similarity_search(
        query_text=name,
        columns=["childcompanyname", "childcompanyid"],
        num_results=5
    )
    rows = result.get("result", {}).get("data_array", [])
    target_found = any(int(float(r[1])) == target_spgid for r in rows)
    print(f"\n=== {name} (target={target_spgid}, in_results={target_found}) ===")
    for r in rows:
        marker = " ✅" if int(float(r[1])) == target_spgid else ""
        print(f"  {r[0]} | id={int(float(r[1]))} | score={r[2]:.4f}{marker}")
