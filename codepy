{
  "name": "sync-kv-to-akv",
  "properties": {
    "description": "Parent: sync HashiCorp Vault KV v2 secrets under secret/prod/moneymovement into Azure Key Vault. Lists secrets, reads each one, then calls child sync-one-kv-secret-to-akv once per secret (ADF cannot nest ForEach inside ForEach). All Web activities run on adfselfhostexcldir-special-projects. Sends one completion email via Logic App listing secrets processed. Child return value is kept for run history, parent does not merge it - SetVariable cannot self-reference.",
    "parameters": {
      "vault_url": {
        "type": "string",
        "defaultValue": "https://hcvault.yourcompany.com:8200"
      },
      "vault_namespace": {
        "type": "string",
        "defaultValue": "your/namespace"
      },
      "kv_mount": {
        "type": "string",
        "defaultValue": "secret"
      },
      "kv_path": {
        "type": "string",
        "defaultValue": "prod/moneymovement"
      },
      "akv_name_prefix": {
        "type": "string",
        "defaultValue": ""
      },
      "role_id": {
        "type": "string",
        "defaultValue": "<approle-role-id>"
      },
      "approle_secret_id_name": {
        "type": "string",
        "defaultValue": "hcv-approle-secret-id"
      },
      "akv_url": {
        "type": "string",
        "defaultValue": "https://kv-cus-synpeacx-prod-01.vault.azure.net"
      },
      "logic_app_url": {
        "type": "string",
        "defaultValue": "<logic-app-http-post-url>"
      },
      "send_email": {
        "type": "bool",
        "defaultValue": true
      }
    },
    "variables": {
      "changes": {
        "type": "Array"
      },
      "current_secret": {
        "type": "String"
      },
      "current_version": {
        "type": "String"
      },
      "current_updated": {
        "type": "String"
      },
      "current_data": {
        "type": "String"
      },
      "completed_secrets": {
        "type": "Array"
      }
    },
    "activities": [
      {
        "name": "get_approle_secret_id",
        "description": "AppRole secret_id used to log in to Vault. Read from AKV so it is never stored in the pipeline.",
        "type": "WebActivity",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "typeProperties": {
          "method": "GET",
          "url": {
            "type": "Expression",
            "value": "@{pipeline().parameters.akv_url}/secrets/@{pipeline().parameters.approle_secret_id_name}?api-version=7.4"
          },
          "connectVia": {
            "referenceName": "adfselfhostexcldir-special-projects",
            "type": "IntegrationRuntimeReference"
          },
          "authentication": {
            "type": "MSI",
            "resource": "https://vault.azure.net"
          }
        }
      },
      {
        "name": "hashVaultLogin",
        "description": "Vault AppRole login.",
        "type": "WebActivity",
        "dependsOn": [
          {
            "activity": "get_approle_secret_id",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "typeProperties": {
          "method": "POST",
          "url": {
            "type": "Expression",
            "value": "@{pipeline().parameters.vault_url}/v1/auth/approle/login"
          },
          "connectVia": {
            "referenceName": "adfselfhostexcldir-special-projects",
            "type": "IntegrationRuntimeReference"
          },
          "headers": {
            "Content-Type": "application/json",
            "X-Vault-Namespace": {
              "type": "Expression",
              "value": "@pipeline().parameters.vault_namespace"
            }
          },
          "body": {
            "role_id": "@{pipeline().parameters.role_id}",
            "secret_id": "@{activity('get_approle_secret_id').output.value}"
          }
        }
      },
      {
        "name": "list_kv_secrets",
        "description": "List KV v2 secrets under kv_path. KV v2 LIST is on the metadata endpoint, not data.",
        "type": "WebActivity",
        "dependsOn": [
          {
            "activity": "hashVaultLogin",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "typeProperties": {
          "method": "GET",
          "url": {
            "type": "Expression",
            "value": "@{pipeline().parameters.vault_url}/v1/@{pipeline().parameters.kv_mount}/metadata/@{pipeline().parameters.kv_path}?list=true"
          },
          "connectVia": {
            "referenceName": "adfselfhostexcldir-special-projects",
            "type": "IntegrationRuntimeReference"
          },
          "headers": {
            "X-Vault-Token": {
              "type": "Expression",
              "value": "@activity('hashVaultLogin').output.auth.client_token"
            },
            "X-Vault-Namespace": {
              "type": "Expression",
              "value": "@pipeline().parameters.vault_namespace"
            }
          }
        }
      },
      {
        "name": "filter_secret_names",
        "description": "Drop sub-folders (keys ending with /). Only real secret names go to the loop.",
        "type": "Filter",
        "dependsOn": [
          {
            "activity": "list_kv_secrets",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "type": "Expression",
            "value": "@activity('list_kv_secrets').output.data.keys"
          },
          "condition": {
            "type": "Expression",
            "value": "@not(endswith(item(), '/'))"
          }
        }
      },
      {
        "name": "for_each_kv_secret",
        "description": "Single ForEach in this pipeline. Sequential on purpose: pipeline variables are not safe in parallel. No nested ForEach here - Execute Pipeline calls the child for the keys.",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "filter_secret_names",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "type": "Expression",
            "value": "@activity('filter_secret_names').output.Value"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "get_kv_secret",
              "description": "KV v2 read. Returns data.data = {client_id, client_secret, ...} and data.metadata = {version, updated_time}. Reading does NOT create a new version.",
              "type": "WebActivity",
              "dependsOn": [],
              "policy": {
                "timeout": "0.00:05:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": true,
                "secureInput": true
              },
              "typeProperties": {
                "method": "GET",
                "url": {
                  "type": "Expression",
                  "value": "@{pipeline().parameters.vault_url}/v1/@{pipeline().parameters.kv_mount}/data/@{pipeline().parameters.kv_path}/@{item()}"
                },
                "connectVia": {
                  "referenceName": "adfselfhostexcldir-special-projects",
                  "type": "IntegrationRuntimeReference"
                },
                "headers": {
                  "X-Vault-Token": {
                    "type": "Expression",
                    "value": "@activity('hashVaultLogin').output.auth.client_token"
                  },
                  "X-Vault-Namespace": {
                    "type": "Expression",
                    "value": "@pipeline().parameters.vault_namespace"
                  }
                }
              }
            },
            {
              "name": "set_current_secret",
              "type": "SetVariable",
              "dependsOn": [
                {
                  "activity": "get_kv_secret",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "variableName": "current_secret",
                "value": {
                  "type": "Expression",
                  "value": "@item()"
                }
              }
            },
            {
              "name": "set_current_version",
              "description": "KV version is the change marker. KV has no last_vault_rotation like LDAP.",
              "type": "SetVariable",
              "dependsOn": [
                {
                  "activity": "set_current_secret",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "variableName": "current_version",
                "value": {
                  "type": "Expression",
                  "value": "@string(activity('get_kv_secret').output.data.metadata.version)"
                }
              }
            },
            {
              "name": "set_current_updated",
              "type": "SetVariable",
              "dependsOn": [
                {
                  "activity": "set_current_version",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "variableName": "current_updated",
                "value": {
                  "type": "Expression",
                  "value": "@string(activity('get_kv_secret').output.data.metadata.updated_time)"
                }
              }
            },
            {
              "name": "set_current_data",
              "description": "Save the whole KV data object as a string to pass to the child. Child must not read the parent's Vault activity.",
              "type": "SetVariable",
              "dependsOn": [
                {
                  "activity": "set_current_updated",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "variableName": "current_data",
                "value": {
                  "type": "Expression",
                  "value": "@string(activity('get_kv_secret').output.data.data)"
                }
              }
            },
            {
              "name": "execute_child_secret",
              "description": "Child pipeline handles this secret's keys. waitOnCompletion=true so parent can read its return value and so a child failure fails this iteration.",
              "type": "ExecutePipeline",
              "dependsOn": [
                {
                  "activity": "set_current_data",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "pipeline": {
                  "referenceName": "sync-one-kv-secret-to-akv",
                  "type": "PipelineReference"
                },
                "waitOnCompletion": true,
                "parameters": {
                  "secret_name": "@variables('current_secret')",
                  "secret_data_json": "@variables('current_data')",
                  "version": "@variables('current_version')",
                  "updated_time": "@variables('current_updated')",
                  "akv_url": "@pipeline().parameters.akv_url",
                  "akv_name_prefix": "@pipeline().parameters.akv_name_prefix",
                  "kv_mount": "@pipeline().parameters.kv_mount",
                  "kv_path": "@pipeline().parameters.kv_path"
                }
              }
            },
            {
              "name": "append_completed_secret",
              "description": "AppendVariable, not SetVariable. SetVariable cannot reference the variable it sets. AppendVariable is the ForEach-safe way to accumulate.",
              "type": "AppendVariable",
              "dependsOn": [
                {
                  "activity": "execute_child_secret",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "variableName": "completed_secrets",
                "value": {
                  "type": "Expression",
                  "value": "@variables('current_secret')"
                }
              }
            }
          ]
        }
      },
      {
        "name": "if_send_email",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "for_each_kv_secret",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "type": "Expression",
            "value": "@pipeline().parameters.send_email"
          },
          "ifTrueActivities": [
            {
              "name": "email_digest_logic_app",
              "description": "One digest email for the whole run. Lists secret names processed, not per-key NEW/UPDATED - that detail lives in the child runs.",
              "type": "WebActivity",
              "dependsOn": [],
              "policy": {
                "timeout": "0.00:05:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "method": "POST",
                "url": {
                  "type": "Expression",
                  "value": "@pipeline().parameters.logic_app_url"
                },
                "connectVia": {
                  "referenceName": "adfselfhostexcldir-special-projects",
                  "type": "IntegrationRuntimeReference"
                },
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "subject": "@{concat('KV to AKV sync completed: ', string(length(variables('completed_secrets'))), ' secrets processed')}",
                  "pipeline": "@{pipeline().Pipeline}",
                  "runId": "@{pipeline().RunId}",
                  "timestamp": "@{utcnow()}",
                  "newCount": "@length(variables('completed_secrets'))",
                  "rotatedCount": 0,
                  "newSecrets": "@variables('completed_secrets')",
                  "rotatedSecrets": []
                }
              }
            }
          ]
        }
      },
      {
        "name": "email_failure_logic_app",
        "description": "Alert when the loop fails",
        "type": "WebActivity",
        "dependsOn": [
          {
            "activity": "for_each_kv_secret",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "typeProperties": {
          "method": "POST",
          "url": {
            "type": "Expression",
            "value": "@pipeline().parameters.logic_app_url"
          },
          "connectVia": {
            "referenceName": "adfselfhostexcldir-special-projects",
            "type": "IntegrationRuntimeReference"
          },
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "subject": "FAILED: KV to AKV sync",
            "pipeline": "@{pipeline().Pipeline}",
            "runId": "@{pipeline().RunId}",
            "timestamp": "@{utcnow()}",
            "newCount": 0,
            "rotatedCount": 0,
            "newSecrets": [],
            "rotatedSecrets": []
          }
        }
      }
    ]
  }
}