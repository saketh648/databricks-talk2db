# ── CONFIG — change these to match your Unity Catalog ────────────────────────

CATALOG    = “main”
SCHEMA     = “default”
TABLE      = “user_registrations”
FULL_TABLE = f”{CATALOG}.{SCHEMA}.{TABLE}”

# ── Databricks SQL connection (uses built-in env vars in Databricks Apps) ─────

@st.cache_resource
def get_connection():
return sql.connect(
server_hostname = os.environ[“DATABRICKS_HOST”],
http_path       = os.environ[“DATABRICKS_HTTP_PATH”],   # set in app config
access_token    = os.environ[“DATABRICKS_TOKEN”],
)

def run_sql(query: str, fetch: bool = False):
conn   = get_connection()
cursor = conn.cursor()
cursor.execute(query)
if fetch:
cols = [d[0] for d in cursor.description]
rows = cursor.fetchall()
return cols, rows
cursor.close()

# ── Ensure table exists ───────────────────────────────────────────────────────

def ensure_table():
run_sql(f”””
CREATE TABLE IF NOT EXISTS {FULL_TABLE} (
id          BIGINT GENERATED ALWAYS AS IDENTITY,
username    STRING    NOT NULL,
email       STRING    NOT NULL,
environment STRING    NOT NULL,
created_at  TIMESTAMP NOT NULL DEFAULT current_timestamp()
)
USING DELTA
COMMENT ‘User registrations collected via Streamlit app’
“””)

