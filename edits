    "marketing_activation_dev_dedicated": 1.51,
    "special_projects__dev_dedicated": 1.51,
    "operations_and_enterprise_dev_dedicated": 1.51,
    "marketing_analytics__prod_dedicated": 15.10,
    "care_prod_dedicated": 15.10,
    "digital_prod_dedicated": 15.10,
    "marketing_analytics_dev_dedicated": 1.51,
    "digital_dev_dedicated": 1.51,
    "locations_analytics_prod_dedicated": 15.10,
    "wcib_prod_dedicated": 15.10
}

print(f"--- 🔍 LIVE INFRASTRUCTURE ANALYSIS: {v_time_select} ({int(hours_window)} Hours) ---")

token = mssparkutils.credentials.getToken("DW")
synapse_sql_endpoint = "synw-synpeacx.sql.azuresynapse.net"
calculated_uptime_hours = {}

# 1. RESILIENT CHECKING PASS
for p_name, hourly_rate in dedicated_hourly_rates.items():
    if v_pool_select != "All" and v_pool_select != p_name:
        continue
        
    jdbc_url = f"jdbc:sqlserver://{synapse_sql_endpoint}:1433;database={p_name};loginTimeout=3;"
    
    # We query a basic internal catalog table to verify if the engine is awake and responding
    check_active_query = "(SELECT TOP 1 OBJECT_ID FROM sys.objects) AS active_test"
    
    try:
        # Test connection status rapidly
        test_df = spark.read.format("jdbc") \
                    .option("url", jdbc_url) \
                    .option("dbtable", check_active_query) \
                    .option("accessToken", token) \
                    .load()
        
        # If the query succeeds, the pool is completely online and active
        calculated_uptime_hours[p_name] = hours_window
    except Exception as e:
        # If it catches an exception (Database paused/unavailable), it logs it as 0 hours
        # without breaking the loops for your other running databases!
        calculated_uptime_hours[p_name] = 0.0

