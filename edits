import streamlit as st
import pandas as pd

st.title("Simple Databricks Form App")

# Form setup
with st.form("user_form"):
    name = st.text_input("Name")
    email = st.text_input("Email")
    environment = st.selectbox(
        "Environment",
        ["Dev", "QA", "Prod"]
    )
    submitted = st.form_submit_button("Submit")

# Handle submit
if submitted:
    if name and email:
        try:
            data = [(name, email, environment)]
            
            # 🚀 LAZY IMPORT: We import it here so the container doesn't crash on startup
            from pyspark.sql import SparkSession
            
            # This automatically links to your active Single-User cluster session
            spark = SparkSession.builder.getOrCreate()
            
            df = spark.createDataFrame(
                data, 
                ["name", "email", "environment"]
            )
            
            # Save to your Delta table inside Unity Catalog
            df.write.mode("append").saveAsTable("default.user_requests")
            
            st.success("🎉 Form submitted successfully!")
            st.write("Submitted Data:")
            st.dataframe(pd.DataFrame(data, columns=["name", "email", "environment"]))
            
        except Exception as e:
            st.error(f"Cluster connection failed: {str(e)}")
    else:
        st.error("Please fill out all fields.")
