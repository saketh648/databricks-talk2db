import time

# 1. EXTRACT RUNNING EXECUTORS AND COMPUTE CAPACITY
total_nodes = len(sc._jsc.sc().statusTracker().getExecutorInfos())
core_count_per_node = int(spark.conf.get("spark.executor.cores", "4")) 

# 2. TRACK UPTIME BOUNDS
uptime_ms = sc._jsc.sc().startTime()
current_ms = int(round(time.time() * 1000))
duration_hours = float(current_ms - uptime_ms) / (1000.0 * 60.0 * 60.0)

# 3. CALCULATE vCPU METRIC COSTS ($0.17 per vCPU Hour standard azure billing rate)
total_vcpu_hours = total_nodes * core_count_per_node * duration_hours
azure_spark_rate_per_vcpu_hour = 0.1700
estimated_spark_cost_usd = total_vcpu_hours * azure_spark_rate_per_vcpu_hour

# 4. TABULATE METRIC DISPLAY TILE
spark_summary_data = [(
    total_nodes, 
    f"{core_count_per_node} vCPUs", 
    f"{round(duration_hours * 60, 1)} Minutes", 
    round(total_vcpu_hours, 3), 
    f"${round(estimated_spark_cost_usd, 4)}"
)]

spark_summary_schema = ["Total Active Nodes", "Node Compute Size", "Notebook Active Uptime", "Total vCPU Hours", "Estimated Cluster Cost (USD)"]
spark_cost_df = spark.createDataFrame(spark_summary_data, spark_summary_schema)

print("--- Current Spark Cluster Infrastructure Billing Metrics ---")
display(spark_cost_df)




