let userFilter = "{UserSearch}";
let selectedPool = "{PoolType}";
//
// 1. Resolve Dedicated Pool Sessions to true LoginNames using the exact case-sensitive schemas
let dedicatedSessions = 
    SynapseSqlPoolSqlRequests
    | summarize hint.strategy=shuffle TakeName = any(LoginName) by SessionId;
//
// 2. Gather Dedicated Pool Telemetry
let dedicatedQueries = 
    SynapseSqlPoolExecRequests
    | where selectedPool in ("All", "Dedicated")
    | join kind=inner dedicatedSessions on SessionId
    | where isempty(userFilter) or TakeName has userFilter
    | project 
        RequestId = RequestId,
        PoolType = "Dedicated",
        User = TakeName,
        SubmitTime = SubmitTime,
        EndTime = EndTime,
        DurationSec = datetime_diff('second', EndTime, StartTime),
        DataProcessedGB = 0.0, 
        QueryText = Command,
        Status = Status;
//
// 3. Gather Serverless Pool Telemetry
let serverlessQueries = 
    SynapseBuiltinSqlPoolRequests
    | where selectedPool in ("All", "Serverless")
    | where isempty(userFilter) or Identity has userFilter
    | project 
        RequestId = RequestId,
        PoolType = "Serverless",
        User = Identity,
        SubmitTime = StartTime,
        EndTime = EndTime,
        DurationSec = datetime_diff('second', EndTime, StartTime),
        DataProcessedGB = 0.0,
        QueryText = QueryText,
        Status = Status;
//
// 4. Combine and Display Results
union dedicatedQueries, serverlessQueries
| order by SubmitTime desc
