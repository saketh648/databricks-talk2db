let userFilter = "{UserSearch}";
let selectedPool = "{PoolType}";
//
// 1. Gather Dedicated Pool Telemetry using only columns verified in your screenshots
let dedicatedQueries = 
    SynapseSqlPoolExecRequests
    | where selectedPool in ("All", "Dedicated")
    | where isempty(userFilter) or ClientCorrelationId has userFilter or Command has userFilter
    | project 
        RequestId = RequestId,
        PoolType = "Dedicated",
        User = iff(isnotempty(ClientCorrelationId), ClientCorrelationId, "System/Service"),
        SubmitTime = SubmitTime,
        EndTime = EndTime,
        DurationSec = datetime_diff('second', EndTime, StartTime),
        DataProcessedGB = 0.0, 
        QueryText = Command,
        Status = Status;
//
// 2. Gather Serverless Pool Telemetry 
let serverlessQueries = 
    SynapseBuiltinSqlPoolRequests
    | where selectedPool in ("All", "Serverless")
    | where isempty(userFilter) or Identity has userFilter or QueryText has userFilter
    | project 
        RequestId = RequestId,
        PoolType = "Serverless",
        User = Identity,
        SubmitTime = StartTime,
        EndTime = EndTime,
        DurationSec = datetime_diff('second', EndTime, StartTime),
        DataProcessedGB = 0.0,
        QueryText = QueryText,
        Status = Status;
//
// 3. Combine and Display Results
union dedicatedQueries, serverlessQueries
| order by SubmitTime desc
