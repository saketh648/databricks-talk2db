import streamlit as st
import pandas as pd
from databricks import sql

# ── 1. CLUSTER CONNECTION PROPERTIES (PASTE YOUR JDBC/ODBC VALUES HERE) ──
SERVER_HOSTNAME = "your-server-hostname.azuredatabricks.net"
HTTP_PATH       = "sql/protocolv1/o/xxxxxx/xxxxxx"
TARGET_TABLE    = "dev.mma_entityresolution.user_requests"

# Set up clean browser tab layouts
st.set_page_config(page_title="Databricks Form Engine", layout="centered")
st.title("🏦 Enterprise Operational Form Portal")
st.markdown("Stream records securely straight to your active development data lakehouse catalog tier.")

# ── 2. USER INTERFACE FRONT-END GRID ────────────────────────────────────
with st.form("user_form", clear_on_submit=True):
    st.subheader("📝 Record Entry Form")
    
    name = st.text_input("Full Name", placeholder="e.g. John Doe")
    email = st.text_input("Corporate Email Address", placeholder="e.g. j.doe@company.com")
    environment = st.selectbox(
        "Deployment Environment Tier", 
        ["Dev", "QA", "Prod"],
        index=0
    )
    
    submitted = st.form_submit_button("🚀 Submit to Unity Catalog")

# ── 3. DATA STREAM ROUTING CORE ─────────────────────────────────────────
if submitted:
    if name and email:
        with st.spinner("Streaming record through secure cluster proxy..."):
            try:
                # Open a direct endpoint channel using ambient App credentials
                # Databricks Apps handles the OAuth handshake seamlessly
                connection = sql.connect(
                    server_hostname=SERVER_HOSTNAME,
                    http_path=HTTP_PATH,
                    auth_type="databricks-oauth" 
                )
                
                cursor = connection.cursor()
                
                # Sanitize single quotes securely to prevent SQL syntax breaks
                safe_name = name.replace("'", "''")
                safe_email = email.replace("'", "''")
                safe_env = environment.replace("'", "''")
                
                # Dynamic compilation targeting the explicit dev catalog namespace
                insert_query = f"""
                INSERT INTO {TARGET_TABLE} (name, email, environment)
                VALUES ('{safe_name}', '{safe_email}', '{safe_env}')
                """
                
                # Execute transaction directly onto the table
                cursor.execute(insert_query)
                cursor.close()
                connection.close()
                
                # Visual Confirmation
                st.success("🎉 Form data recorded successfully in Unity Catalog!")
                
                st.markdown("### 📋 Captured Payload Summary:")
                preview_df = pd.DataFrame(
                    [{"Field": "Full Name", "Value": name},
                     {"Field": "Email Address", "Value": email},
                     {"Field": "Target Environment", "Value": environment}]
                )
                st.table(preview_df)
                st.balloons()
                
            except Exception as e:
                st.error(f"❌ Execution Halted: {str(e)}")
                st.info("Verify your cluster is active and your server hostname/HTTP path constants are accurate.")
    else:
        st.error("⚠️ Submission blocked: Please ensure both Name and Email fields are fully populated.")
