token = mssparkutils.credentials.getToken("DW")

diag_query = """
(
    SELECT TOP 20
        r.request_id,
        r.start_time,
        r.end_time,
        r.submit_time,
        r.status,
        DATEDIFF(second, r.start_time, r.end_time) AS calc_duration,
        r.total_elapsed_time
    FROM sys.dm_pdw_exec_requests r
    WHERE r.start_time IS NOT NULL
    ORDER BY r.submit_time DESC
) AS diag
"""

diag_df = (
    spark.read.format("jdbc")
    .option("url", "jdbc:sqlserver://synw-synpeacx.sql.azuresynapse.net:1433;database=Care_dev_dedicated;loginTimeout=5;")
    .option("dbtable", diag_query)
    .option("accessToken", token)
    .load()
)

diag_df.show(20, truncate=False)
