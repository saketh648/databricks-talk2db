# --- COLOR CODED STYLED TABLE ---
def style_table(df):
    def color_status(val):
        if val == "Failed":
            return "background-color:#fce4ec; color:#c62828; font-weight:600;"
        elif val == "Completed":
            return "background-color:#e8f5e9; color:#2e7d32; font-weight:600;"
        elif val == "Running":
            return "background-color:#e8f4fd; color:#0078d4; font-weight:600;"
        return ""

    def color_pool(val):
        if val == "Serverless":
            return "background-color:#f3f0ff; color:#7048e8; font-weight:600;"
        elif val == "Dedicated":
            return "background-color:#fff8e1; color:#f9a825; font-weight:600;"
        return ""

    return (
        df.style
        .map(color_status, subset=["Status"])     # .map replaces deprecated .applymap
        .map(color_pool,   subset=["PoolType"])
        .set_table_styles([
            {"selector": "thead th", "props": [
                ("background-color", "#0078d4"),
                ("color", "white"),
                ("font-family", "Segoe UI, sans-serif"),
                ("font-size", "12px"),
                ("font-weight", "600"),
                ("text-transform", "uppercase"),
                ("letter-spacing", "0.4px"),
                ("padding", "10px 14px"),
                ("border", "none")
            ]},
            {"selector": "tbody td", "props": [
                ("font-family", "Segoe UI, sans-serif"),
                ("font-size", "12px"),
                ("padding", "8px 14px"),
                ("border-bottom", "1px solid #f0f0f0"),
                ("vertical-align", "top"),
                ("max-width", "400px"),
                ("word-wrap", "break-word")
            ]},
            {"selector": "tbody tr:hover", "props": [
                ("background-color", "#f0f7ff")
            ]},
            {"selector": "table", "props": [
                ("border-collapse", "collapse"),
                ("width", "100%"),
                ("border-radius", "8px"),
                ("overflow", "hidden"),
                ("box-shadow", "0 2px 8px rgba(0,0,0,0.08)")
            ]}
        ])
        .hide(axis="index")
    )

ipydisplay(style_table(output_pd))
