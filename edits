from pyspark.sql import functions as F

# 1. Grab your security token
token = mssparkutils.credentials.getToken("DW")

# 2. Point to your specific serverless on-demand endpoint
# TODO: Update with your exact workspace serverless name prefix
serverless_sql_endpoint = "yourworkspace-ondemand.sql.azuresynapse.net" 
serverless_jdbc_url = f"jdbc:sqlserver://{serverless_sql_endpoint}:1433;database=master"

# 3. Direct query targeting the hidden history DMV
test_history_query = """
(
    SELECT TOP 10
        r.request_id AS ReqId,
        r.login_name AS UserIdentity,
        r.start_time AS SubmitTime,
        DATEDIFF(second, r.start_time, r.end_time) AS DurationSec,
        r.command AS QueryText,
        r.status AS Status,
        CAST(r.data_processed_mb AS float) AS DataProcessedMB
    FROM sys.dm_exec_requests_history r
    ORDER BY r.end_time DESC
) AS test_hist
"""

print("Testing direct serverless connection to history logs...")
try:
    test_df = spark.read.format("jdbc") \
        .option("url", serverless_jdbc_url) \
        .option("dbtable", test_history_query) \
        .option("accessToken", token) \
        .load()
        
    print(f"Success! Retrieved {test_df.count()} historical serverless rows.")
    display(test_df)
except Exception as e:
    print(f"Connection failed or view not accessible. Error: {str(e)}")
