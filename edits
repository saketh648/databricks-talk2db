// 1. Map Dedicated Session IDs to their true Human Login Identities
let dedicatedUserMap = 
    SynapseSqlPoolSqlRequests
    | where isnotempty(LoginName)
    | summarize TakeUser = any(LoginName) by SessionId;
//
// 2. Gather Dedicated Pool Telemetry linked to the User Map
let dedicatedQueries = 
    SynapseSqlPoolExecRequests
    | where TimeGenerated >= ago(24h)
    | join kind=leftouter dedicatedUserMap on SessionId
    | project 
        ReqId = tostring(column_ifexists("RequestId", "")),
        PoolType = "Dedicated",
        -- If the join finds a user identity, use it; otherwise fallback to the system client app name
        User = iff(isnotempty(TakeUser), TakeUser, iff(isnotempty(ClientCorrelationId), ClientCorrelationId, "System/Service")),
        SubmitTime = SubmitTime,
        EndTime = EndTime,
        DurationSec = datetime_diff('second', EndTime, StartTime),
        QueryText = Command,
        Status = Status;
//
// 3. Gather Serverless Pool Telemetry
let serverlessQueries = 
    SynapseBuiltinSqlPoolRequestsEnded
    | where TimeGenerated >= ago(24h)
    | project 
        ReqId = tostring(column_ifexists("RequestId", column_ifexists("requestId", column_ifexists("requestId_s", "")))),
        PoolType = "Serverless",
        User = tostring(column_ifexists("Identity", column_ifexists("identity_s", "System/Service"))),
        SubmitTime = todatetime(column_ifexists("StartTime", column_ifexists("startTime_t", TimeGenerated))),
        EndTime = todatetime(column_ifexists("EndTime", column_ifexists("endTime_t", TimeGenerated))),
        DurationSec = datetime_diff('second', 
            todatetime(column_ifexists("EndTime", TimeGenerated)), 
            todatetime(column_ifexists("StartTime", TimeGenerated))
        ),
        QueryText = tostring(column_ifexists("QueryText", column_ifexists("queryText_s", "Internal Command"))),
        Status = tostring(column_ifexists("Status", column_ifexists("status_s", "Completed")));
//
// 4. Combine and Display Results
union dedicatedQueries, serverlessQueries
| order by SubmitTime desc
