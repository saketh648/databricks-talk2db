from pyspark.sql import functions as F
from pyspark.sql.types import *

v_pool_select = pool_name_w.value
v_time_select = time_filter_w.value

# Determine lookback interval for the Azure system tables
days_back = 1
if v_time_select == "Past 3 Days": days_back = 3

# Base pricing scale multiplier: Azure Dedicated Pools cost approx $0.0151 per DWU per hour
# Example: DW100c = 100 * 0.0151 = $1.51/hr | DW1000c = 1000 * 0.0151 = $15.10/hr
DWU_HOURLY_BASE_RATE = 0.0151

# Query the master system notification history to track raw ALTER DATABASE scale commands
scale_history_query = f"""
(
    SELECT 
        LOWER(p.name) as PoolName,
        h.command_text as Command,
        h.event_timestamp as EventTime
    FROM sys.dm_pdw_request_notification_history h
    JOIN sys.databases p ON h.database_id = p.database_id
    WHERE h.command_text LIKE '%MODIFY%SERVICE_OBJECTIVE%'
      AND h.event_timestamp >= DATEADD(day, -{days_back}, GETDATE())
) AS scale_logs
"""

print(f"--- 🛰️ PARSING LIVE AZURE FABRIC SCALING TIMELINES ---")

token = mssparkutils.credentials.getToken("DW")
master_jdbc_url = "jdbc:sqlserver://synw-synpeacx.sql.azuresynapse.net:1433;database=master"

try:
    # Read the historical scale commands directly from the master control plane
    raw_scale_df = spark.read.format("jdbc") \
                        .option("url", master_jdbc_url) \
                        .option("dbtable", scale_history_query) \
                        .option("accessToken", token).load()
                        
    # Parse out the target DWU string from the raw SQL command text using regex
    # Example string parsed: "ALTER DATABASE MyPool MODIFY (SERVICE_OBJECTIVE = 'DW500c')" -> Extracts "500"
    parsed_scale_df = raw_scale_df.withColumn(
        "ExtractedDWU", 
        F.regexp_extract(F.col("Command"), r"SERVICE_OBJECTIVE\s*=\s*'DW(\d+)c'", 1).cast("double")
    ).fillna(100.0, subset=["ExtractedDWU"]) # Default to base DW100c if unparsed
    
    parsed_scale_df.cache()
    print(" -> Successfully mapped workspace resource modification timelines.")
except Exception as e:
    print(f" -> [System Note] Master scale telemetry unavailable. Falling back to base configurations.")
    parsed_scale_df = None
