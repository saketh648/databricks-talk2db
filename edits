# Slice in-memory cached logs instantly 
final_dashboard_df = base_filtered_df.filter((F.col("UserIdentity") == v_user) | (F.lit(v_user) == "All")) \
                                     .orderBy(F.col("SubmitTime").desc())

print(f"Displaying Interactive Workspace Log Framework For User: {v_user}")
