SynapseSqlPoolExecRequests
| take 5
| project Properties


let userFilter = "{UserSearch}";
let selectedPool = "{PoolType}";
//
// 1. Gather Dedicated Pool Telemetry
let dedicatedQueries = 
    SynapseSqlPoolExecRequests
    | where selectedPool in ("All", "Dedicated")
    | extend 
        LoginName = tostring(Properties.loginName),
        CommandText = tostring(Properties.command),
        StatusText = tostring(Properties.status),
        ReqId = tostring(Properties.requestId),
        DurationMs = tolong(Properties.durationMs)
    | where isempty(userFilter) or LoginName has userFilter
    | project 
        RequestId = ReqId,
        PoolType = "Dedicated",
        User = LoginName,
        SubmitTime = TimeGenerated,
        EndTime = TimeGenerated + totimespan(DurationMs * 10000), // Approximate end time from duration
        DurationSec = round(DurationMs / 1000.0, 2),
        DataProcessedGB = 0.0, 
        QueryText = CommandText,
        Status = StatusText;
//
// 2. Gather Serverless Pool Telemetry
let serverlessQueries = 
    SynapseBuiltinSqlPoolRequests
    | where selectedPool in ("All", "Serverless")
    | extend 
        LoginName = tostring(Properties.identity),
        CommandText = tostring(Properties.queryText),
        StatusText = tostring(Properties.status),
        ReqId = tostring(Properties.requestId),
        DurationMs = tolong(Properties.durationMs)
    | where isempty(userFilter) or LoginName has userFilter
    | project 
        RequestId = ReqId,
        PoolType = "Serverless",
        User = LoginName,
        SubmitTime = TimeGenerated,
        EndTime = TimeGenerated + totimespan(DurationMs * 10000),
        DurationSec = round(DurationMs / 1000.0, 2),
        DataProcessedGB = 0.0,
        QueryText = CommandText,
        Status = StatusText;
//
// 3. Union and Display Results
union dedicatedQueries, serverlessQueries
| order by SubmitTime desc
