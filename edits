from pyspark.sql import functions as F
from pyspark.sql.types import *
import ipywidgets as widgets
from IPython.display import display as ipydisplay

# Force Spark data grids to maximize string allocations for broken/Failed scripts
spark.conf.set("spark.sql.debug.maxToStringFields", "5000")

# 1. CAPTURE ACTIVE DROPDOWN VALUES FROM CELL 1
v_type = pool_type_w.value
v_name = pool_name_w.value
v_time = time_filter_w.value
v_status = status_w.value

# Calculate dynamic time windows
days_lookback = 1; hours_lookback = 0
if v_time == "Past 1 Hour":   days_lookback = 0; hours_lookback = 1
elif v_time == "Past 4 Hours": days_lookback = 0; hours_lookback = 4
elif v_time == "Past 3 Days":  days_lookback = 3; hours_lookback = 0

print(f"🚀 Initializing Extraction -> Type={v_type} | Pool={v_name} | Lookback={v_time} | Status={v_status}...\n")

# 2. SECURITY HANDSHAKE AND WORKSPACE ROUTING MATRIX
token = mssparkutils.credentials.getToken("DW")
synapse_sql_endpoint = "synw-synpeacx.sql.azuresynapse.net" 

teams_config = [
    {"team": "Care Team", "pool": "Care_dev_dedicated"},
    {"team": "Operations Team", "pool": "ac_operations__dev_dedicated_new"},
    {"team": "WCIB Corporate Team", "pool": "wcib_dev_dedicated"},
    {"team": "Operations Team", "pool": "operations_and_enterprise_prod_dedicated"},
    {"team": "Marketing Data Team", "pool": "marketing_data_products_prod_dedicated"},
    {"team": "Marketing Act Team", "pool": "marketing_activation_dev_dedicated"},
    {"team": "Special Projects Team", "pool": "special_projects__dev_dedicated"},
    {"team": "Operations Team", "pool": "operations_and_enterprise_dev_dedicated"},
    {"team": "Marketing Analyt Team", "pool": "marketing_analytics__prod_dedicated"},
    {"team": "Care Team", "pool": "care_prod_dedicated"},
    {"team": "Digital Product Team", "pool": "digital_prod_dedicated"},
    {"team": "Marketing Analyt Team", "pool": "marketing_analytics_dev_dedicated"},
    {"team": "Digital Product Team", "pool": "digital_dev_dedicated"},
    {"team": "Location Analyt Team", "pool": "locations_analytics_prod_dedicated"},
    {"team": "WCIB Corporate Team", "pool": "wcib_prod_dedicated"}
]

# Schema template blueprint to keep both data streams perfectly uniform
schema_template = StructType([
    StructField("ReqId", StringType(), True), StructField("UserIdentity", StringType(), True),
    StructField("SubmitTime", TimestampType(), True), StructField("DurationSec", LongType(), True),
    StructField("QueryText", StringType(), True), StructField("Status", StringType(), True),
    StructField("PoolType", StringType(), True), StructField("PoolName", StringType(), True),
    StructField("TeamName", StringType(), True), StructField("DataProcessedGB", DoubleType(), True),
    StructField("EstimatedCostUSD", DoubleType(), True)
])

# 3. PHASE A: EXECUTE DEDICATED DMV PASS-THROUGH PIPELINE
dedicated_dmv_query = f"""
(
    SELECT 
        r.request_id AS ReqId,
        s.login_name AS UserIdentity,
        r.submit_time AS SubmitTime,
        DATEDIFF(second, r.start_time, r.end_time) AS DurationSec,
        r.command AS QueryText,
        r.status AS Status
    FROM sys.dm_pdw_exec_requests r
    JOIN sys.dm_pdw_exec_sessions s ON r.session_id = s.session_id
    WHERE r.start_time >= DATEADD({ 'hour' if hours_lookback > 0 else 'day' }, -{ hours_lookback if hours_lookback > 0 else days_lookback }, GETDATE())
) AS logs
"""

dedicated_dfs = []
if v_type.lower() != "serverless" and (v_name == "All" or "dedicated" in v_name.lower() or v_name in [c["pool"] for c in teams_config]):
    for cfg in teams_config:
        if v_name != "All" and v_name != cfg["pool"]:
            continue
            
        jdbc_url = f"jdbc:sqlserver://{synapse_sql_endpoint}:1433;database={cfg['pool']};loginTimeout=5;"
        print(f" -> Accessing Live Database DMVs: {cfg['pool']}...")
        
        try:
            tmp_df = spark.read.format("jdbc").option("url", jdbc_url).option("dbtable", dedicated_dmv_query).option("accessToken", token).load()
            tmp_df = tmp_df.withColumn("TeamName", F.lit(cfg["team"]))\
                           .withColumn("PoolName", F.lit(cfg["pool"]))\
                           .withColumn("PoolType", F.lit("Dedicated"))\
                           .withColumn("DataProcessedGB", F.lit(0.0))\
                           .withColumn("EstimatedCostUSD", F.lit(0.0).cast(DoubleType()))
            dedicated_dfs.append(tmp_df)
        except:
            pass # Skips any pools that are completely offline/paused to keep app fast

if dedicated_dfs:
    master_dedicated_df = dedicated_dfs[0]
    for next_df in dedicated_dfs[1:]: master_dedicated_df = master_dedicated_df.unionByName(next_df)
else:
    master_dedicated_df = spark.createDataFrame([], schema_template)

# 4. PHASE B: SERVERLESS LOG INGESTION WITH METADATA RECOVERY HANDLERS
master_serverless_df = spark.createDataFrame([], schema_template)

if v_type.lower() == "serverless" or v_name == "All" or "serverless" in v_name.lower() or v_name == "Built-in (Serverless)":
    print(" -> Scanning Serverless Log Registry Table...")
    try:
        serverless_lookback = '1h' if v_time == 'Past 1 Hour' else '4h' if v_time == 'Past 4 Hours' else '1d' if v_time == 'Past 24 Hours' else '3d'
        serverless_raw = spark.read.table("SynapseBuiltinSqlPoolRequestsEnded").filter(f"StartTime >= ago({serverless_lookback})")
        
        master_serverless_df = serverless_raw.select(
            F.col("RequestId").alias("ReqId"), 
            F.col("Identity").alias("UserIdentity"), 
            F.col("StartTime").alias("SubmitTime"),
            
            # Bulletproof Duration Fix: Converts matching or null timestamps to clean 0 integers (fixes "undefined")
            F.when(
                F.col("EndTime").isNull() | F.col("StartTime").isNull() | (F.col("EndTime") == F.col("StartTime")), 
                F.lit(0)
            ).otherwise(
                F.unix_timestamp("EndTime") - F.unix_timestamp("StartTime")
            ).cast(LongType()).alias("DurationSec"), 
            
            F.coalesce(F.trim(F.col("QueryText")), F.lit("MALFORMED SCRIPT / INSTANT PARSE FAILURE")).alias("QueryText"), 
            F.col("Status")
        ).withColumn("PoolType", F.lit("Serverless"))\
         .withColumn("PoolName", F.lit("Built-in (Serverless)"))\
         .withColumn("TeamName", F.lit("Shared Infrastructure"))\
         .withColumn("DataProcessedGB", F.round(F.col("dataProcessedBytes_d") / (1024*1024*1024), 3))\
         .withColumn("EstimatedCostUSD", F.round(F.col("DataProcessedGB") * 0.0048828, 4))
    except Exception as serverless_err:
        print(f"    [System Note] Serverless engine metadata table empty or resting: {str(serverless_err)}")

# 5. PHASE C: STITCHING LOG REPOSITORIES AND APPLYING UI DROPDOWN FILTERS
raw_master_df = master_dedicated_df.unionByName(master_serverless_df)

base_filtered_df = raw_master_df.filter(
    (F.lower(F.col("PoolType")) == v_type.lower()) | (F.lit(v_type) == "All")
).filter(
    (F.lower(F.col("PoolName")).contains("built-in")) if "serverless" in v_name.lower() else ((F.col("PoolName") == v_name) | (F.lit(v_name) == "All"))
).filter(
    (F.col("Status").rlike(f"(?i){v_status}")) | (F.lit(v_status) == "All")
)

# Freeze dataset in hot memory (RAM) so Cell 3 executes in milliseconds
base_filtered_df.cache()

# 6. ASSEMBLE USER IDENTITY SELECTOR BOX
unique_users = [row['UserIdentity'] for row in base_filtered_df.select("UserIdentity").distinct().collect() if row['UserIdentity']]
unique_users.sort()
unique_users.insert(0, "All")

user_filter_w = widgets.Dropdown(options=unique_users, value="All", description="View User:")
print(f"\n--- SUCCESS: Data Funnel Fully Cached! {len(unique_users)-1} unique user trails active. ---")
ipydisplay(user_filter_w)









# 1. READ INTERACTIVE SELECTED DROPDOWN VALUE FROM CELL 2
v_user = user_filter_w.value
v_status = status_w.value

# Micro-slice the hot memory cache instantaneously
final_dashboard_df = base_filtered_df.filter(
    (F.col("UserIdentity") == v_user) | (F.lit(v_user) == "All")
).orderBy(F.col("SubmitTime").desc())

# 2. COMPUTE BASELINE SUMMARY AGGREGATIONS
total_queries = final_dashboard_df.count()
avg_execution_time = final_dashboard_df.select(F.avg("DurationSec")).collect()[0][0] or 0.0

is_serverless_scope = final_dashboard_df.filter(F.col("PoolType") == "Serverless").count() > 0
is_dedicated_scope = final_dashboard_df.filter(F.col("PoolType") == "Dedicated").count() > 0

print("=" * 85)
print(f" 📊 METRICS CANVAS | USER AUDIT: {v_user.upper()} | CRITERIA STATUS: {v_status.upper()} ")
print("=" * 85)
print(f" -> Total Query Volume in Selected View : {total_queries}")
print(f" -> Average Query Execution Speed       : {round(avg_execution_time, 2)} Seconds")

# 3. SMART ADAPTIVE SEPARATOR (CONVERT VISUAL LAYOUT BASED ON INFRASTRUCTURE MODEL)
if is_serverless_scope and not is_dedicated_scope:
    total_serverless_cost = final_dashboard_df.select(F.sum("EstimatedCostUSD")).collect()[0][0] or 0.0
    total_data_scanned = final_dashboard_df.select(F.sum("DataProcessedGB")).collect()[0][0] or 0.0
    print(f" -> Total Data Lake Storage Scanned     : {round(total_data_scanned, 3)} GB")
    print(f" 💸 Accumulated Consumption Cost        : ${round(float(total_serverless_cost), 4)}")
    
elif is_dedicated_scope and not is_serverless_scope:
    longest_query = final_dashboard_df.select(F.max("DurationSec")).collect()[0][0] or 0.0
    print(f" 🚀 Peak Single Query Runtime Captured   : {longest_query} Seconds")
    print(f" [Note] Dedicated Pools are billed on flat capacity, adding $0.00 transactional usage.")

else:
    total_serverless_cost = final_dashboard_df.filter(F.col("PoolType") == "Serverless").select(F.sum("EstimatedCostUSD")).collect()[0][0] or 0.0
    print(f" 💸 Blended Environment Serverless Cost  : ${round(float(total_serverless_cost), 4)}")
    print(f" [Information] Mixed environment in view. Isolate individual pools for precise performance limits.")

print("=" * 85 + "\n")

# 4. RENDER LIVE DYNAMIC DATA GRID
display(final_dashboard_df)
