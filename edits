dedicated_dmv_query = f"""
(
    SELECT
        r.request_id                                AS ReqId,
        s.login_name                                AS UserIdentity,
        r.submit_time                               AS SubmitTime,
        CASE 
            WHEN r.end_time IS NULL OR r.start_time IS NULL 
                THEN DATEDIFF(second, r.start_time, GETDATE())
            WHEN r.end_time = r.start_time 
                THEN 0
            ELSE DATEDIFF(second, r.start_time, r.end_time)
        END                                         AS DurationSec,
        r.command                                   AS QueryText,
        r.status                                    AS Status
    FROM sys.dm_pdw_exec_requests r
    JOIN sys.dm_pdw_exec_sessions s ON r.session_id = s.session_id
    WHERE r.start_time >= DATEADD(
        {'hour' if hours_lookback > 0 else 'day'},
        -{hours_lookback if hours_lookback > 0 else days_lookback},
        GETDATE()
    )
) AS logs
"""
