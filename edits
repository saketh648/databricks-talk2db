# 5. REVISED RESILIENT INFRASTRUCTURE FILTERING
# If Serverless is selected, we bypass strict pool naming checks since it's the Built-in engine
if v_type.lower() == "serverless":
    base_filtered_df = clean_master_df.filter(F.col("PoolType") == "Serverless")
elif v_type.lower() == "dedicated":
    base_filtered_df = clean_master_df.filter(F.col("PoolType") == "Dedicated")\
                                      .filter((F.col("PoolName") == v_name) | (F.lit(v_name) == "All"))
else:
    # 'All' View Scope
    base_filtered_df = clean_master_df.filter(
        (F.col("PoolName") == v_name) | 
        (F.lit(v_name) == "All") | 
        (F.col("PoolType") == "Serverless")
    )

base_filtered_df.cache()

# 6. GENERATE INTERACTIVE DESKTOP DROPDOWNS
# Extracting clean flat strings from your loaded rows
unique_users = [row['UserIdentity'] for row in base_filtered_df.select("UserIdentity").distinct().collect() if row['UserIdentity']]
unique_users.sort()
unique_users.insert(0, "All")

user_filter_w = widgets.Dropdown(options=unique_users, value="All", description="View User:")
status_filter_w = widgets.Dropdown(options=["All", "Completed", "Running", "Failed", "Cancelled"], value="All", description="Query Status:")
type_filter_w = widgets.Dropdown(options=["All", "SELECT (Read)", "DML (Write)", "DDL (Schema)", "System/Procedure"], value="All", description="Command Class:")

print(f"--- SUCCESS: {base_filtered_df.count()} Base Master Records Cached In-Memory! ---")
print(f"Identified {len(unique_users)-1} distinct active user identities.")
ipydisplay(user_filter_w, status_filter_w, type_filter_w)
