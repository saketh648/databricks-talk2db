def load_monthly_to_table(aod_c):
    # 1. Fetch paths from your helper function
    parquet_stage_abfss, _ = get_monthly_stage_paths(aod_c)
    
    # 2. Read the source parquet files into a DataFrame
    df = spark.read.parquet(parquet_stage_abfss)
    
    # 3. Fetch token for authentication
    access_token = mssparkutils.credentials.getToken("DW")
    
    print(f"Starting optimized JDBC Bulk load into Dedicated Pool for date: {aod_c}...")
    
    # 4. Standard JDBC format but loaded with parameters to force bulk speed
    (
        df.write
        .format("jdbc")                                                    # Safe standard format to avoid data source errors
        .option("url", jdbc_url_write)
        .option("dbtable", "dgsa_gold.balance_flow_monthly")
        .option("driver", "com.microsoft.sqlserver.jdbc.SQLServerDriver")    # Leverages your working driver
        .option("accessToken", access_token)
        .option("isolationLevel", "NONE")                                  # Drops transactional logging overhead
        .option("batchsize", "150000")                                     # Groups records into massive network flushes
        .option("tableLock", "true")                                       # CRITICAL: Disables row-locks to allow direct bulk writes
        .mode("append")
        .save()
    )
    
    print("Bulk load write complete. Fetching inserted row count...")

    # 5. Fast Count Check using the exact same safe JDBC setup
    inserted_rows = (
        spark.read
        .format("jdbc")
        .option("url", jdbc_url_write)
        .option("driver", "com.microsoft.sqlserver.jdbc.SQLServerDriver")
        .option("accessToken", access_token)
        .option("query", f"""
            SELECT COUNT(*) AS cnt 
            FROM dgsa_gold.balance_flow_monthly 
            WHERE as_of_dt = '{aod_c}'
        """)
        .load()
        .collect()[0]["cnt"]
    )
    
    print(f"Successfully processed. Total rows for {aod_c}: {inserted_rows}")
    return inserted_rows
