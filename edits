let userFilter = "{UserSearch}";
let selectedPool = "{PoolType}";
//
// 1. Gather Dedicated Pool Telemetry
let dedicatedQueries = 
    SynapseSqlPoolExecRequests
    | where selectedPool in ("All", "Dedicated")
    | where isempty(userFilter) or ClientCorrelationId has userFilter or Command has userFilter
    | project 
        RequestId = RequestId,
        PoolType = "Dedicated",
        User = iff(isnotempty(ClientCorrelationId), ClientCorrelationId, "System/Service"),
        SubmitTime = SubmitTime,
        EndTime = EndTime,
        DurationSec = datetime_diff('second', EndTime, StartTime),
        DataProcessedGB = 0.0, 
        QueryText = Command,
        Status = Status;
//
// 2. Safely probe for the Serverless table using dynamically resolved execution
let serverlessQueries = 
    table("SynapseBuiltinSqlPoolRequestsEnded", true) // The 'true' flag skips compilation failure if missing
    | where selectedPool in ("All", "Serverless")
    | extend ExtUser = coalesce(
        tostring(column_ifexists("Identity", "")), 
        tostring(column_ifexists("identity_s", ""))
      )
    | extend ExtQueryText = coalesce(
        tostring(column_ifexists("QueryText", "")), 
        tostring(column_ifexists("queryText_s", ""))
      )
    | where isempty(userFilter) or ExtUser has userFilter or ExtQueryText has userFilter
    | project 
        RequestId = tostring(column_ifexists("RequestId", column_ifexists("requestId_s", ""))),
        PoolType = "Serverless",
        User = iff(ExtUser != "", ExtUser, "System/Internal"),
        SubmitTime = todatetime(column_ifexists("StartTime", column_ifexists("startTime_t", TimeGenerated))),
        EndTime = todatetime(column_ifexists("EndTime", column_ifexists("endTime_t", TimeGenerated))),
        DurationSec = datetime_diff('second', 
            todatetime(column_ifexists("EndTime", TimeGenerated)), 
            todatetime(column_ifexists("StartTime", TimeGenerated))
        ),
        DataProcessedGB = 0.0,
        QueryText = ExtQueryText,
        Status = tostring(column_ifexists("Status", column_ifexists("status_s", "Completed")));
//
// 3. Combine and Display Results
union dedicatedQueries, serverlessQueries
| order by SubmitTime desc
