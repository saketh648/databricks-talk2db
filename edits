col_refresh, col_filter = st.columns([1, 2])
with col_refresh:
    refresh = st.button("🔄 Refresh", use_container_width=True)
with col_filter:
    filter_env = st.selectbox("Filter by environment", ["All", "dev", "prod"], label_visibility="collapsed")

where = "" if filter_env == "All" else f"WHERE environment = '{filter_env}'"
try:
    cols, rows = run_sql(
        f"SELECT id, username, email, environment, created_at FROM {FULL_TABLE} {where} ORDER BY created_at DESC LIMIT 100",
        fetch=True,
    )

    if not rows:
        st.info("No records found.")
    else:
        st.caption(f"{len(rows)} record(s)")
        for row in rows:
            rec = dict(zip(cols, row))
            badge_class = "env-prod" if rec["environment"] == "prod" else "env-dev"
            st.markdown(f"""
            <div class="record-card">
                <strong>{rec['username']}</strong> &nbsp;
                <span class="env-badge {badge_class}">{rec['environment']}</span><br/>
                <span style="color:#555">{rec['email']}</span>
                <span style="float:right;color:#aaa;font-size:0.8rem">{str(rec['created_at'])[:19]}</span>
            </div>
            """, unsafe_allow_html=True)
except Exception as ex:
    st.error(f"Could not load records: {ex}")
