from pyspark.sql import functions as F
from pyspark.sql.types import *

# -------------------------------------------------------------------------
# 1. GENERATE DYNAMIC AUTHENTICATION TOKEN (CURRENT USER / MSI PASSTHROUGH)
# -------------------------------------------------------------------------
# "DW" tells Synapse to fetch a secure token explicitly for Azure Synapse SQL
token = mssparkutils.credentials.getToken("DW")

# -------------------------------------------------------------------------
# 2. CONFIGURATION (GUINEA PIG: TEAM FINANCE)
# -------------------------------------------------------------------------
synapse_sql_endpoint = "yourworkspace.sql.azuresynapse.net" 
dedicated_db_name = "finance_dw" 

jdbc_url = f"jdbc:sqlserver://{synapse_sql_endpoint}:1433;database={dedicated_db_name}"

# -------------------------------------------------------------------------
# 3. PULL LIVE DEDICATED DMVs USING THE ACCESS TOKEN
# -------------------------------------------------------------------------
dedicated_dmv_query = """
(
    SELECT 
        r.request_id AS ReqId,
        s.login_name AS UserIdentity,
        r.submit_time AS SubmitTime,
        DATEDIFF(second, r.start_time, r.end_time) AS DurationSec,
        r.command AS QueryText,
        r.status AS Status
    FROM sys.dm_pdw_exec_requests r
    JOIN sys.dm_pdw_exec_sessions s ON r.session_id = s.session_id
    WHERE r.start_time >= DATEADD(day, -1, GETDATE())
) AS logs
"""

print(f"Connecting token-free to Dedicated Pool: {dedicated_db_name}...")

dedicated_df = spark.read.format("jdbc") \
    .option("url", jdbc_url) \
    .option("dbtable", dedicated_dmv_query) \
    .option("accessToken", token) \
    .load()

# Add metadata tracking tags
dedicated_df = dedicated_df.withColumn("TeamName", F.lit("Team_Finance")) \
                           .withColumn("PoolName", F.lit(dedicated_db_name)) \
                           .withColumn("PoolType", F.lit("Dedicated")) \
                           .withColumn("DataProcessedGB", F.lit(0.0)) \
                           .withColumn("EstimatedCostUSD", F.lit(0.0))

# -------------------------------------------------------------------------
# 4. PULL NATIVE SERVERLESS LOGS
# -------------------------------------------------------------------------
print("Pulling Serverless log framework...")
try:
    serverless_raw = spark.read.table("SynapseBuiltinSqlPoolRequestsEnded") \
        .filter("TimeGenerated >= ago(1d)")
        
    serverless_df = serverless_raw.select(
        F.col("RequestId").alias("ReqId"),
        F.col("Identity").alias("UserIdentity"),
        F.col("StartTime").alias("SubmitTime"),
        (F.unix_timestamp("EndTime") - F.unix_timestamp("StartTime")).alias("DurationSec"),
        F.col("QueryText"),
        F.col("Status")
    ).withColumn("PoolType", F.lit("Serverless")) \
     .withColumn("PoolName", F.lit("Built-in")) \
     .withColumn("TeamName", F.lit("Team_Finance")) \
     .withColumn("DataProcessedGB", F.round(F.col("dataProcessedBytes_d") / (1024*1024*1024), 3)) \
     .withColumn("EstimatedCostUSD", F.round(F.col("DataProcessedGB") * 0.0048828, 4))
except:
    schema = StructType([
        StructField("ReqId", StringType(), True), StructField("UserIdentity", StringType(), True),
        StructField("SubmitTime", TimestampType(), True), StructField("DurationSec", LongType(), True),
        StructField("QueryText", StringType(), True), StructField("Status", StringType(), True),
        StructField("PoolType", StringType(), True), StructField("PoolName", StringType(), True),
        StructField("TeamName", StringType(), True), StructField("DataProcessedGB", DoubleType(), True),
        StructField("EstimatedCostUSD", DoubleType(), True)
    ])
    serverless_df = spark.createDataFrame([], schema)

# -------------------------------------------------------------------------
# 5. UNION RESULTS FOR VISUALIZATION
# -------------------------------------------------------------------------
master_df = dedicated_df.unionByName(serverless_df).orderBy(F.col("SubmitTime").desc())
master_df.cache()

print("Execution complete! Data mapped into master dataframe safely.")
