         .withColumn("EstimatedCostUSD", F.round(F.col("DataProcessedGB") * 0.0048828, 4)) \
         .drop("Bytes")
    except Exception as e:
        print(f"    [Note] No storage logs compiled for this timeframe yet: {str(e)}")
