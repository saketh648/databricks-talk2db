let userFilter = "{UserSearch}";
let selectedPool = "{PoolType}";
//
// 1. Gather Dedicated Pool Telemetry
let dedicatedQueries = 
    SynapseSqlPoolExecRequests
    | where selectedPool in ("All", "Dedicated")
    | where isempty(userFilter) or loginName_s has userFilter
    | project 
        RequestId = requestId_s,
        PoolType = "Dedicated",
        User = loginName_s,
        SubmitTime = startTime_t,
        EndTime = endTime_t,
        DurationSec = round(durationMs_d / 1000.0, 2),
        DataProcessedGB = 0.0, 
        QueryText = command_s,
        Status = status_s;
//
// 2. Gather Serverless Pool Telemetry
let serverlessQueries = 
    SynapseBuiltinSqlPoolRequests
    | where selectedPool in ("All", "Serverless")
    | where isempty(userFilter) or identity_s has userFilter
    | project 
        RequestId = requestId_s,
        PoolType = "Serverless",
        User = identity_s,
        SubmitTime = startTime_t,
        EndTime = endTime_t,
        DurationSec = round(durationMs_d / 1000.0, 2),
        // If dataProcessedBytes_d isn't in your table, you can change this line to: DataProcessedGB = 0.0
        DataProcessedGB = round(dataProcessedBytes_d / (1024.0 * 1024.0 * 1024.0), 3),
        QueryText = queryText_s,
        Status = status_s;
//
// 3. Union and Display Results
union dedicatedQueries, serverlessQueries
| order by SubmitTime desc
