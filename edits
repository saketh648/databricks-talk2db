<div style="
    background: #f0f7ff;
    border: 1px solid #cce0ff;
    border-left: 4px solid #0078d4;
    border-radius: 8px;
    padding: 14px 20px;
    margin: 12px 0;
    font-family: Segoe UI, sans-serif;
">
    <span style="font-size:15px; font-weight:600; color:#0078d4;">✅ Data Cached</span>
    <span style="font-size:13px; color:#333; margin-left:12px;">
        <b>{len(unique_users)-1}</b> unique users found across selected pools
