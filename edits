pool_names_list = [
    "All",
    "Care_dev_dedicated",
    "ac_operations__dev_dedicated_new",
    "wcib_dev_dedicated",
    "operations_and_enterprise_prod_dedicated",
    "marketing_data_products_prod_dedicated",
    "marketing_activation_dev_dedicated",
    "special_projects__dev_dedicated",
