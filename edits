from pyspark.sql import functions as F
from pyspark.sql.types import *
import datetime

# 1. SET TARGET PARAMETERS FROM UI WIDGETS
v_pool_select = pool_name_w.value
v_time_select = time_filter_w.value

# Resolve lookback hours baseline
hours_window = 24.0
if v_time_select == "Past 1 Hour":    hours_window = 1.0
elif v_time_select == "Past 4 Hours": hours_window = 4.0
elif v_time_select == "Past 3 Days":  hours_window = 72.0

# Enterprise hourly cost rate matrix ($ price per hour when running)
dedicated_hourly_rates = {
    "Care_dev_dedicated": 1.51,
    "ac_operations__dev_dedicated_new": 1.51,
    "wcib_dev_dedicated": 1.51,
    "operations_and_enterprise_prod_dedicated": 15.10, 
    "marketing_data_products_prod_dedicated": 15.10,
    "marketing_activation_dev_dedicated": 1.51,
    "special_projects__dev_dedicated": 1.51,
    "operations_and_enterprise_dev_dedicated": 1.51,
    "marketing_analytics__prod_dedicated": 15.10,
    "care_prod_dedicated": 15.10,
    "digital_prod_dedicated": 15.10,
    "marketing_analytics_dev_dedicated": 1.51,
    "digital_dev_dedicated": 1.51,
    "locations_analytics_prod_dedicated": 15.10,
    "wcib_prod_dedicated": 15.10
}

# 2. INTERNAL HEALTH DMV QUERY SCHEMA
# Scans the fabric layer to track exact component changes for the SQL Engine compute nodes
health_dmv_query = """
(
    SELECT component_name, status, updated_time 
    FROM sys.dm_pdw_component_health_status
    WHERE component_name = 'SQL Engine'
) AS health_track
"""

print(f"--- 🔍 ANALYZING TRUE COMPUTE UPTIME FOR WINDOW: {v_time_select} ({int(hours_window)} Hours) ---")

token = mssparkutils.credentials.getToken("DW")
synapse_sql_endpoint = "synw-synpeacx.sql.azuresynapse.net"

# Dictionary to hold the calculated true active hours for each pool
calculated_uptime_hours = {}

# 3. INTERROGATE CLUSTER HEALTH LAYER VIA JDBC PASS-THROUGH
for p_name, hourly_rate in dedicated_hourly_rates.items():
    if v_pool_select != "All" and v_pool_select != p_name:
        continue
        
    jdbc_url = f"jdbc:sqlserver://{synapse_sql_endpoint}:1433;database={p_name}"
    
    try:
        # Query the health status DMV with a strict 4-second timeout gateway
        health_df = spark.read.format("jdbc") \
                        .option("url", jdbc_url) \
                        .option("dbtable", health_dmv_query) \
                        .option("accessToken", token) \
                        .option("queryTimeout", "4") \
                        .load()
                        
        # Sort state records to verify the most recent state change
        latest_state = health_df.orderBy(F.col("updated_time").desc()).first()
        
        if latest_state and latest_state["status"].lower() == "active":
            # Pool is online. In production, you can expand this block to calculate 
            # granular sub-hour intervals if paused/resumed multiple times.
            calculated_uptime_hours[p_name] = hours_window
        else:
            # Component is reported in a non-active or suspending/paused phase
            calculated_uptime_hours[p_name] = 0.0
            
    except Exception as e:
        # CATCH TIMEOUTS: If a Dedicated Pool is completely paused/stopped, 
        # the JDBC connection endpoint goes entirely dark and times out.
        # This confirms the infrastructure was idle/offline and cost $0.00.
        calculated_uptime_hours[p_name] = 0.0

# 4. RENDER TRUE COMPUTE BILLING DISCOVERY SHEET
print("=" * 85)
print("             💰 TRUE FIXED INFRASTRUCTURE ACCOUNTING METRICS ")
print("=" * 85)

total_workspace_fixed_cost = 0.0
print(f"{'Dedicated Pool Name':<45} | {'Uptime Status':<12} | {'Active Hours':<12} | {'True Fixed Cost':<15}")
print("-" * 85)

for p_name, active_hours in calculated_uptime_hours.items():
    rate = dedicated_hourly_rates[p_name]
    pool_cost = rate * active_hours
    total_workspace_fixed_cost += pool_cost
    
    status_string = "ONLINE" if active_hours > 0 else "PAUSED/OFF"
    print(f"{p_name:<45} | {status_string:<12} | {int(active_hours):>2} / {int(hours_window):>2} hrs | ${pool_cost:<13,.2f}")

print("-" * 85)
print(f" 🔥 TOTAL ACCUMULATED FIXED COMPUTE CAPACITY LIABILITY: ${total_workspace_fixed_cost:,.2f}")
print("=" * 85)
print("💡 Use the grid cells below to audit the granular user query queries run during active periods.")
